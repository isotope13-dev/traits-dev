# Note-cavity ELF infection detected on the compiled artifact (the
# companion to c-source.yaml, which detects the infector's C source, and
# elf-asm.yaml, the hand-written assembly form). A PT_NOTE→PT_LOAD
# note-cavity infector leaves a fixed structural fingerprint in the host
# it patches: a second executable load segment grafted beside the real
# text, the entry point redirected into a non-code section, and the note
# whose program header was repurposed left orphaned in the section table
# (its GNU build-id still on disk but unreachable through the headers).
# The atoms are neutral ELF anomalies under metadata/binary/anomaly; this
# composite reads their conjunction as the infection.
defaults:
  platforms: [linux, unix]
  for: [elf]
  attack: T1554
  mbc: B0009

composite_rules:
  - id: elf-note-cavity-infection
    desc: Note-cavity ELF file infection
    crit: hostile
    conf: 0.97
    all:
      - id: metadata/binary/anomaly/format::elf-executable-segment-graft
      - id: metadata/binary/anomaly/format::elf-entry-in-nonstandard-section
      - id: metadata/binary/anomaly/format::elf-note-uncovered
    any:
      - id: metadata/binary/anomaly/format::elf-build-id-uncovered
      - id: metadata/binary/anomaly/format::elf-entry-in-last-segment
    unless:
      - id: metadata/binary/vendor/
      - id: metadata/file/extension/identity::linux-firmware-blob-basename
      - id: well-known/tool/development/patchelf::patchelf-test-fixture
