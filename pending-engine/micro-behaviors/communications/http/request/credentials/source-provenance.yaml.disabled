# Policy and library models are YAML. filefacts supplies only value links.
defaults:
  platforms: [unix, windows]
  crit: suspicious
  conf: 0.94

traits:
  - id: go-credential-file-body-provenance
    desc: Go credential file enters HTTP body
    for: [go]
    if:
      type: symbol
      kind: call
      exact: net/http.Post
      arg:
        index: 2
        from:
          call: '^(os|io/ioutil)\.ReadFile$'
          literal: '(\.npmrc|\.pypirc|\.netrc|\.git-credentials|id_rsa|id_ed25519|\.(aws|azure)[/\\]credentials|\.vault-token|\.cargo[/\\]credentials)'
          through:
            - call: '^(strings|bytes)\.New(Reader|Buffer|BufferString)$'
              arguments: [0]
            - call: '^append$'
              arguments: [0, 1]
            - call: '^(path|path/filepath)\.Join$'
              arguments: [0, 1, 2, 3]

  - id: go-named-secret-body-provenance
    desc: Go environment secret enters HTTP body
    for: [go]
    if:
      type: symbol
      kind: call
      exact: net/http.Post
      arg:
        index: 2
        from:
          call: '^os\.(Getenv|LookupEnv)$'
          literal: '(?i)(TOKEN|SECRET|PASSWORD|API_KEY|ACCESS_KEY)'
          through:
            - call: '^(strings|bytes)\.New(Reader|Buffer|BufferString)$'
              arguments: [0]

  - id: python-named-secret-body-provenance
    desc: Python environment secret enters HTTP body
    for: [python]
    if:
      type: symbol
      kind: call
      regex: '^(requests|httpx)\.(post|put|patch)$'
      arg:
        index: 1
        from:
          call: '^os\.getenv$'
          literal: '(?i)(TOKEN|SECRET|PASSWORD|API_KEY|ACCESS_KEY)'

  - id: python-named-secret-data-provenance
    desc: Python secret enters HTTP data argument
    for: [python]
    if:
      type: symbol
      kind: call
      regex: '^(requests|httpx)\.(post|put|patch)$'
      arg:
        from:
          field: data
          call: '^os\.getenv$'
          literal: '(?i)(TOKEN|SECRET|PASSWORD|API_KEY|ACCESS_KEY)'

  - id: python-named-secret-json-provenance
    desc: Python secret enters HTTP JSON argument
    for: [python]
    if:
      type: symbol
      kind: call
      regex: '^(requests|httpx)\.(post|put|patch)$'
      arg:
        from:
          field: json
          call: '^os\.getenv$'
          literal: '(?i)(TOKEN|SECRET|PASSWORD|API_KEY|ACCESS_KEY)'

  - id: node-file-body-provenance
    desc: Fetch body derives from a credential file
    for: [javascript, typescript]
    if:
      type: symbol
      kind: call
      exact: fetch
      arg:
        index: 1
        from:
          field: body
          call: '^(fs|fs\.promises)\.(readFileSync|readFile)$'
          literal: '(\.npmrc|\.pypirc|\.netrc|\.git-credentials|id_rsa|id_ed25519|\.aws[/\\]credentials)'

  - id: rust-named-secret-body-provenance
    desc: Rust environment secret enters HTTP body
    for: [rust]
    if:
      type: symbol
      kind: call
      regex: '^ureq::post\(\)\.send_(string|bytes|json)$'
      arg:
        index: 0
        from:
          call: '^(std::)?env::var(_os)?$'
          literal: '(?i)(TOKEN|SECRET|PASSWORD|API_KEY|ACCESS_KEY)'
          through:
            - call: '\.(unwrap|expect|as_str|as_bytes)$'
              receiver: true

  - id: curl-secret-body-provenance
    desc: Environment secret enters curl request body
    for: [c]
    if:
      type: symbol
      kind: call
      exact: curl_easy_setopt
      args:
        - index: 1
          kind: identifier
          name: CURLOPT_POSTFIELDS
        - index: 2
          from:
            call: '^getenv$'
            literal: '(?i)(TOKEN|SECRET|PASSWORD|API_KEY|ACCESS_KEY)'
