# Cross-layer AUR builder compromise.
#
# The outer rule works on a captured AUR snapshot without registry access: its
# PKGBUILD disables source integrity and sudo-runs that source, while another
# archive member is a compact stripped ELF whose strings are decrypted from a
# ChaCha table at runtime. Neither member has to name the other beyond the
# PKGBUILD source-execution chain, so variants can rename the payload.
#
# The package rule adds live registry provenance. A freshly modified release of
# a long-established, single-maintainer AUR package carrying the outer chain is
# the account-takeover / malicious-revision shape. Age and maintainer count are
# intentionally only corroboration: old one-person AUR packages are common and
# must never be suspicious on their own.
defaults:
  platforms: [linux]
  for: [all]
  attack: "T1195.002,T1027"

composite_rules:
  - id: aur-bundled-native-builder-payload
    desc: PKGBUILD root-runs an unverified stripped native payload
    crit: hostile
    conf: 0.99
    scope: outer
    all:
      - id: objectives/supply-chain/install-hook/build-function::pkgbuild-unverified-sudo-source-exec
      - id: metadata/hardening/missing::stripped-binary

  - id: aur-bundled-encrypted-builder-payload
    desc: PKGBUILD root-runs an unverified encrypted native payload
    crit: hostile
    conf: 0.99
    scope: outer
    all:
      - id: aur-bundled-native-builder-payload
      - id: objectives/anti-static/obfuscation/payload/encrypted::native-chacha-runtime-string-table

  - id: fresh-aur-privileged-source-execution
    desc: Fresh AUR release runs unverified source as root
    crit: hostile
    conf: 0.99
    scope: package
    all:
      - id: metadata/registry::aur-package
      - id: metadata/registry::freshly-published
      - id: objectives/supply-chain/install-hook/build-function::pkgbuild-unverified-sudo-source-exec

  - id: fresh-established-aur-native-builder-compromise
    desc: Fresh release of established AUR package compromises builder
    crit: hostile
    conf: 0.995
    scope: package
    all:
      - id: fresh-aur-privileged-source-execution
      - id: metadata/registry::established-package
      - id: metadata/registry::single-maintainer
