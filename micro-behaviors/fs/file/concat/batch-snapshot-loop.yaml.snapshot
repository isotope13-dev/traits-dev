defaults:
  platforms: [windows]
  for: [batch]
traits:
  - id: batch-unbounded-snapshot-concat-loop
    desc: Unbounded batch snapshot-concatenation loop
    crit: suspicious
    conf: 0.97
    if:
      type: metrics
      field: source.batch.unbounded_snapshot_concat_loops
      min: 1
  - id: batch-seeded-snapshot-concat-loop
    desc: Batch appends seed data within COPY loop
    crit: notable
    conf: 0.97
    if:
      type: metrics
      field: source.batch.seeded_snapshot_concat_loops
      min: 1
