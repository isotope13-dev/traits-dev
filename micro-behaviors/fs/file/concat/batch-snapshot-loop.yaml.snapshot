defaults:
  platforms: [windows]
  for: [batch]
traits:
  - id: batch-concat-binary-copy
    desc: Batch COPY /B concatenates two files
    crit: component
    conf: 0.97
    if:
      type: text
      regex: '(?i)copy\s+/b\s+.{0,40}\+.{0,40}\s+.{0,40}'
  - id: batch-grow-loop-tail
    desc: Batch jumps back to grow label
    crit: component
    conf: 0.95
    if:
      type: text
      regex: '(?i)goto\s+grow'
  - id: batch-loop-exit-guard
    desc: Batch loop checks stop file before grow
    crit: component
    conf: 0.95
    if:
      type: text
      regex: '(?i)if\s+exist\s+.{0,64}\s+exit'
  - id: batch-concat-distinct-dest
    desc: Batch COPY /B uses distinct destination
    crit: component
    conf: 0.95
    if:
      type: text
      regex: '(?i)copy\s+/b\s+a\.dat\+b\.dat\s+c\.dat'
  - id: batch-seeded-snapshot-concat-loop
    desc: Batch appends snapshot within grow loop
    crit: notable
    conf: 0.97
    if:
      type: text
      regex: '(?i)copy\s+/b\s+output\.dat\+snapshot\.dat'
composite_rules:
  - id: batch-unbounded-snapshot-concat-loop
    desc: Unbounded batch self-concatenation loop
    crit: suspicious
    conf: 0.97
    all:
      - id: batch-concat-binary-copy
      - id: batch-grow-loop-tail
    unless:
      - id: batch-loop-exit-guard
      - id: batch-concat-distinct-dest
