        <service android:name=".Svc" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="false"/>
        <service android:name=".Ime" android:permission="android.permission.BIND_INPUT_METHOD"/>
        <service android:name=".Nl" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"/>
    </application>
</manifest>
