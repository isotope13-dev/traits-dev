#!/bin/bash
set -euo pipefail
curl -fsSL "https://downloads.vendor.invalid/VendorApp.app.zip" -o "/tmp/VendorApp.app.zip"
ditto -x -k "/tmp/VendorApp.app.zip" "/Applications"
rm "/tmp/VendorApp.app.zip"
spctl --assess --type execute "/Applications/VendorApp.app"
chmod -R 755 "/Applications/VendorApp.app"
open "/Applications/VendorApp.app"
exit 0
