<html><head>
<HTA:APPLICATION ID="oClock" APPLICATIONNAME="clock" SCROLL="no" SINGLEINSTANCE="yes" WINDOWSTATE="minimize">
<script>
function tick(){document.getElementById("c").innerText = new Date().toLocaleTimeString();}
window.onload = function(){ tick(); window.setInterval(tick, 1000); };
</script>
</head><body><div id="c"></div></body></html>
