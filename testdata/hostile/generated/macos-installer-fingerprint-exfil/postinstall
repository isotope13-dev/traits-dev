#!/bin/sh
# Variant: renamed identifiers, system_profiler serial source, changed
# endpoints, full tool paths, PlistBuddy Set form. Exercises the same
# installer-hook hardware-fingerprint exfiltration technique as the
# MacKeeper postinstall specimen without reusing its names or hosts.
VENDOR_VER="6.6.1"
PKG_URL="https://cdn.example-vendor.net/desktop/${VENDOR_VER}/DesktopApp.pkg"
TMPDIR_WORK=$(mktemp -q -d)
PKG_PATH="${TMPDIR_WORK}/DesktopApp.pkg"
CFG_PATH="${TMPDIR_WORK}/com.example.DesktopApp.cfg"

IFACE_MAC=$(/usr/sbin/networksetup -getmacaddress Wi-Fi | grep -o -E '([[:xdigit:]]{1,2}:){5}[[:xdigit:]]{1,2}')
SYS_SERIAL=$(system_profiler SPHardwareDataType | awk '/Serial Number/{print $4}')
DEV_ID=$(echo "${SYS_SERIAL}|${IFACE_MAC}" | sed -e 's/:/%3A/g;s/|/%7C/g')

curl -q -f --silent --data "step=InstallPing&version=${VENDOR_VER}&device_id=${DEV_ID}&substep=Begin" "https://telemetry.example-vendor.net/ping" >> /dev/null
curl -q -f --silent -m 300 "${PKG_URL}" -o "${PKG_PATH}" >> /dev/null
/usr/sbin/spctl --assess --type install "${PKG_PATH}"
installer -pkg "${PKG_PATH}" -target LocalSystem
curl -q -f --silent --data "step=InstallPing&version=${VENDOR_VER}&device_id=${DEV_ID}&substep=Done" "https://telemetry.example-vendor.net/ping" >> /dev/null
/usr/libexec/PlistBuddy -c "Set :DEVICE_ID string ${DEV_ID}" "${CFG_PATH}" 2>/dev/null
exit 0
