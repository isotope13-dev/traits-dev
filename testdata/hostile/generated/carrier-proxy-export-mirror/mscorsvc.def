; bellatrix -- export surface of the carrier proxy.
;
; Mirrors C:\Windows\Microsoft.NET\Framework64\v4.0.30319\mscorsvc.dll exactly:
; the same seven names, ordinal base 1, the same order. tools/test_proxy
; fails the build if the two ever diverge.
LIBRARY mscorsvc
EXPORTS
    CorCreateNGenProcess      @1
    CorGetNGenPolicy          @2
    CorGetSvc                 @3
    CorInitSvcLogger          @4
    CorSetCriticalTaskState   @5
    CorStopNonCriticalTask    @6
    CorSvcLog                 @7
