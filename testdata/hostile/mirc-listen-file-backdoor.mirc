alias serve { socklisten files 58 }
on 1:socklisten:files: { sockaccept peer }
on 1:sockread:peer: {
  sockread %line
  set %verb $gettok(%line,1,32)
  if (%verb == file) { sendfile $gettok(%line,2,32) }
  if (%verb == del) { remove $gettok(%line,2,32) }
}
alias sendfile {
  bread $1 0 4096 &chunk
  sockwrite peer &chunk
}
