{
  "claim": "NOP byte runs belong under instruction/padding, not instruction/sequence.",
  "moves": [
    {
      "from": "metadata/binary/instruction/sequence::nop-padding-run",
      "to": "metadata/binary/instruction/padding::nop-padding-run",
      "effective_definition": {
        "platforms": [
          "linux",
          "macos",
          "windows"
        ],
        "for": [
          "elf",
          "macho",
          "pe"
        ],
        "id": "nop-padding-run",
        "desc": "Repeated NOP padding in text section",
        "crit": "baseline",
        "conf": 0.65,
        "count_min": 4,
        "size_max": 1000000,
        "if": {
          "type": "hex",
          "section": ".text",
          "pattern": "90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90"
        }
      },
      "definition_unchanged": true
    },
    {
      "from": "metadata/binary/instruction/sequence::long-nop-padding-run",
      "to": "metadata/binary/instruction/padding::long-nop-padding-run",
      "effective_definition": {
        "platforms": [
          "linux",
          "macos",
          "windows"
        ],
        "for": [
          "elf",
          "pe"
        ],
        "id": "long-nop-padding-run",
        "desc": "Long NOP padding run in executable code",
        "crit": "baseline",
        "conf": 0.7,
        "if": {
          "type": "hex",
          "section": ".text",
          "pattern": "90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90"
        }
      },
      "definition_unchanged": true
    }
  ],
  "other_source_rules": "Retained in place without edits",
  "consumers_updated": [
    "metadata/binary/instruction/padding/padding-profile.yaml",
    "objectives/anti-analysis/self-modify/runtime/traits.yaml"
  ],
  "controls": {
    "positive": "PE .text with 256 contiguous NOP bytes; both atoms matched (long run is normally stripped from report if unreferenced).",
    "near_miss": "PE .text with 15 contiguous NOP bytes; neither atom matched.",
    "ancestor_selectors": "No exact instruction/sequence or instruction parent selectors found in YAML consumers."
  }
}
