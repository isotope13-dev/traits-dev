{
  "description": "Import references must not stand in for unrelated behavior; package metadata and explicit operations remain independently visible.",
  "cases": [
    {
      "path": "boto3-powershell-literal.py",
      "command": "analyze",
      "must_match": [
        "metadata/import/python/boto3::boto3"
      ],
      "must_not_match": []
    },
    {
      "path": "telegram-with-tqdm.py",
      "command": "test-rules",
      "rule": "objectives/exfiltration/messaging/webhook::telegram-bot-api",
      "expect": "not matched",
      "must_contain": [
        "telegram-api-host"
      ],
      "must_not_contain": [
        "metadata/import/python/tqdm"
      ]
    },
    {
      "path": "npmrc-fetch-with-urllib3.js",
      "command": "analyze",
      "must_match": [
        "metadata/import/npm/urllib3::urllib3",
        "micro-behaviors/fs/read/file/full::node-package-credential-read-reference"
      ],
      "must_not_match": [
        "metadata/import/python/urllib3"
      ]
    },
    {
      "path": "websocket-import-only.py",
      "command": "analyze",
      "must_match": [
        "metadata/import/python/websocket::websocket",
        "metadata/import/python/websockets::websockets"
      ],
      "must_not_match": []
    },
    {
      "path": "websocket-import-only.py",
      "command": "test-rules",
      "rule": "micro-behaviors/communications/websocket/handler::websocket-library-api-reference",
      "expect": "not matched",
      "must_contain": [],
      "must_not_contain": []
    },
    {
      "path": "websocket-client-use.py",
      "command": "test-rules",
      "rule": "micro-behaviors/communications/websocket/handler::websocket-library-api-reference",
      "expect": "matched",
      "must_contain": [
        "python-websocket-client"
      ],
      "must_not_contain": []
    },
    {
      "path": "fixtures/boto3-operational-path.exe",
      "command": "test-rules",
      "must_match": [
        "micro-behaviors/fs/path/drive-root::hardcoded-windows-root"
      ],
      "must_not_match": [
        "well-known/lib/cloud/botocore::botocore-lib"
      ],
      "rule": "micro-behaviors/fs/path/drive-root::hardcoded-windows-root",
      "expect": "matched",
      "must_contain": [
        "raw[regex]"
      ],
      "must_not_contain": []
    },
    {
      "path": "fixtures/boto3-bundled-sdk-path.exe",
      "command": "analyze",
      "must_match": [
        "well-known/lib/cloud/botocore::botocore-lib",
        "micro-behaviors/fs/path/drive-root::hardcoded-windows-root"
      ],
      "must_not_match": [],
      "max_crit": {
        "micro-behaviors/fs/path/drive-root::hardcoded-windows-root": 1
      }
    },
    {
      "path": "fileutils-import-path.rb",
      "command": "test-rules",
      "rule": "micro-behaviors/fs/file/read-write::ruby-file-read-write-or-fileutils",
      "expect": "not matched",
      "must_contain": [],
      "must_not_contain": []
    },
    {
      "path": "fileutils-import-path.rb",
      "command": "test-rules",
      "rule": "objectives/supply-chain/install-hook/package/rubygems::credential-path-access",
      "expect": "not matched",
      "must_contain": [],
      "must_not_contain": []
    },
    {
      "path": "fileutils-copy-credential.rb",
      "command": "test-rules",
      "rule": "micro-behaviors/fs/file/read-write::ruby-file-read-write-or-fileutils",
      "expect": "matched",
      "must_contain": [
        "ruby-fileutils-copy"
      ],
      "must_not_contain": []
    },
    {
      "path": "fileutils-copy-credential.rb",
      "command": "test-rules",
      "rule": "objectives/supply-chain/install-hook/package/rubygems::credential-path-access",
      "expect": "matched",
      "must_contain": [
        "ruby-file-read-write-or-fileutils"
      ],
      "must_not_contain": []
    },
    {
      "path": "ruby-read-credential.rb",
      "command": "test-rules",
      "rule": "objectives/supply-chain/install-hook/package/rubygems::credential-path-access",
      "expect": "matched",
      "must_contain": [],
      "must_not_contain": []
    }
  ]
}
