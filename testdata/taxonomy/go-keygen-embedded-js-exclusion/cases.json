{
  "baseline": "Compare a genuine Go GenerateKey method with an inert JavaScript asset containing the same Go-looking text. The combined binary tests whether file-wide embedded-JavaScript suppression hides the real Go symbol.",
  "rule": "micro-behaviors/crypto/asymmetric/key::go-obfuscated-keygen",
  "embedded_javascript": "metadata/lang/embedded::javascript",
  "fixtures": [
    {
      "name": "symbol-only",
      "build_tags": "keygen",
      "expect_keygen": true,
      "expect_embedded_javascript": false
    },
    {
      "name": "embedded-javascript-only",
      "build_tags": "embeddedjs",
      "expect_keygen": false,
      "expect_embedded_javascript": true,
      "expect_keygen_suppressed_by_embedded_javascript": true
    },
    {
      "name": "symbol-plus-embedded-javascript",
      "build_tags": "keygen embeddedjs",
      "expect_keygen": false,
      "expect_embedded_javascript": true,
      "expect_keygen_suppressed_by_embedded_javascript": true
    }
  ]
}
