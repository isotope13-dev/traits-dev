{
  "purpose": "Verify OpAMP path and basename clues never suppress client-certificate behavior or quoted private_key evidence. The fixtures include exact upstream files, deliberately copied identity clues, and sibling-file controls.",
  "source": {
    "repository": "https://github.com/open-telemetry/opentelemetry-python-contrib",
    "commit": "8a28139d156f74e2c1a5637f726f8a9f5d5bd905",
    "files": [
      "opamp/opentelemetry-opamp-client/src/opentelemetry/_opamp/client.py",
      "opamp/opentelemetry-opamp-client/src/opentelemetry/_opamp/proto/opamp_pb2.py",
      "opamp/opentelemetry-opamp-client/src/opentelemetry/_opamp/transport/requests.py"
    ]
  },
  "rules": [
    "well-known/lib/network/opentelemetry-opamp::opentelemetry-opamp-client-library",
    "objectives/lateral-movement/exploit/network-device/provisioning::client-certificate-request",
    "micro-behaviors/data/parse/vocabulary::private-key-field-name"
  ],
  "fixtures": [
    {
      "id": "authentic-client-source",
      "path": "authentic/opentelemetry/_opamp/client.py",
      "expected": {
        "opamp": true,
        "certificate_request": false,
        "private_key_field": false
      },
      "note": "Authentic upstream client source; path leg applies. TLS client certificate/key are passed through to the transport.",
      "suppressed": {
        "certificate_request": false,
        "private_key_field": false
      }
    },
    {
      "id": "authentic-protobuf-stub",
      "path": "authentic/opentelemetry/_opamp/proto/opamp_pb2.py",
      "expected": {
        "opamp": true,
        "certificate_request": false,
        "private_key_field": false
      },
      "note": "Authentic generated protobuf source; path leg applies. Descriptor contains TLSCertificate.private_key encoded in a serialized descriptor, not a quoted Python field key.",
      "suppressed": {
        "certificate_request": false,
        "private_key_field": false
      }
    },
    {
      "id": "authentic-transport-cert-call",
      "path": "authentic/opentelemetry/_opamp/transport/requests.py",
      "expected": {
        "opamp": true,
        "certificate_request": true,
        "private_key_field": false
      },
      "note": "Authentic upstream transport source contains cert=client_cert at requests.post; the behavior remains visible under the OpAMP path.",
      "suppressed": {
        "certificate_request": false,
        "private_key_field": false
      }
    },
    {
      "id": "copied-path-with-credentials",
      "path": "copied/opentelemetry/_opamp/copycat.py",
      "expected": {
        "opamp": true,
        "certificate_request": true,
        "private_key_field": true
      },
      "note": "Synthetic copied path with both credential indicators; both behaviors remain visible despite the path clue.",
      "suppressed": {
        "certificate_request": false,
        "private_key_field": false
      }
    },
    {
      "id": "copied-basename-with-credentials",
      "path": "copied-basename/opamp_pb2.py",
      "expected": {
        "opamp": true,
        "certificate_request": true,
        "private_key_field": true
      },
      "note": "Synthetic basename-only copy with both credential indicators; both behaviors remain visible despite the basename clue.",
      "suppressed": {
        "certificate_request": false,
        "private_key_field": false
      }
    },
    {
      "id": "sibling-credential-source",
      "path": "sibling/credential/service.py",
      "expected": {
        "opamp": false,
        "certificate_request": true,
        "private_key_field": true
      },
      "note": "Credential-bearing file is scanned alongside authentic OpAMP client source, but is outside its path; both credential behaviors remain visible.",
      "suppressed": {
        "certificate_request": false,
        "private_key_field": false
      }
    },
    {
      "id": "authentic-transport-outside-OpAMP-path",
      "path": "sibling/credential/requests.py",
      "expected": {
        "opamp": false,
        "certificate_request": true,
        "private_key_field": false
      },
      "suppressed": {
        "certificate_request": false,
        "private_key_field": false
      },
      "note": "Byte-identical authentic upstream transport source moved outside the suppressor path; its cert=client_cert request is detected."
    },
    {
      "id": "sibling-authentic-client-source",
      "path": "sibling/opentelemetry/_opamp/client.py",
      "expected": {
        "opamp": true,
        "certificate_request": false,
        "private_key_field": false
      },
      "note": "Authentic OpAMP path used as a sibling marker; it does not suppress findings in another file.",
      "suppressed": {
        "certificate_request": false,
        "private_key_field": false
      }
    }
  ]
}
