{
  "baseline": "Embedded shell text is not evidence that the containing JavaScript launches those shell commands. An independent parsed process call remains evidence when it occurs in the same file.",
  "embedded_shell_marker": "metadata/lang/embedded::shell",
  "suppressed_rules": [
    "micro-behaviors/process/create/script/file::shell-script-execution",
    "micro-behaviors/process/create/script/file::shell-script-execution-env",
    "micro-behaviors/process/create/script/file::shell-script-execution-alt",
    "micro-behaviors/process/create/script/file::shell-script-execution-dot",
    "micro-behaviors/process/create/shell/spawn::bash-keyword"
  ],
  "operation_rule": "micro-behaviors/process/create/shell/bridge::js-function-bash-first-arg",
  "fixtures": [
    {
      "file": "embedded-only.js",
      "expect_embedded_shell": true,
      "expect_operation": false
    },
    {
      "file": "live-operation.js",
      "expect_embedded_shell": false,
      "expect_operation": true
    },
    {
      "file": "embedded-plus-operation.js",
      "expect_embedded_shell": true,
      "expect_operation": true
    }
  ]
}
