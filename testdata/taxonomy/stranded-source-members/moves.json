{
  "mapping": {
    "metadata/package/files/archive-member::path-traversal-members": "metadata/file/archive::path-traversal-members",
    "metadata/package/files/archive-member::archive-parent-path-web-member": "metadata/file/archive::archive-parent-path-web-member",
    "metadata/package/files/archive-member::archive-parent-path-server-page-suffix": "metadata/file/archive::archive-parent-path-server-page-suffix",
    "metadata/package/files/archive-member::member-at-least-10mb": "metadata/file/archive::member-at-least-10mb",
    "metadata/package/files/archive-member::member-at-least-100mb": "metadata/file/archive::member-at-least-100mb",
    "metadata/file/archive::nupkg-managed-library-layout": "metadata/package/files/nuget::nupkg-managed-library-layout",
    "metadata/file/archive::nupkg-dotnet-tool-layout": "metadata/package/files/nuget::nupkg-dotnet-tool-layout",
    "metadata/file/archive::rocm-experiment": "well-known/app/ai/gateway/ollama::ollama-rocm-archive-layout",
    "metadata/file/archive::pyinstaller-overlay-exe-toc-entry": "metadata/binary/section/layout::pyinstaller-overlay-exe-toc-entry",
    "micro-behaviors/data/parse/vocabulary::reverse-shell-term": "metadata/lang/natural::reverse-shell-term",
    "micro-behaviors/ui/window/form-input::php-command-named-form-control": "micro-behaviors/ui/controls/input::php-command-named-form-control",
    "micro-behaviors/ui/window/password-field::php-password-input-element": "micro-behaviors/ui/controls/credential::php-password-input-element",
    "metadata/file/archive::tiny-rar5-container": "metadata/file/size::tiny-rar5-container",
    "metadata/file/archive::tiny-rar4-container": "metadata/file/size::tiny-rar4-container"
  },
  "before": {
    "metadata/package/files/archive-member::path-traversal-members": {
      "source": "metadata/package/files/archive-member/shape.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "windows",
          "linux"
        ],
        "for": [
          "zip",
          "tar",
          "jar",
          "whl",
          "python-sdist",
          "gem",
          "deb",
          "rpm",
          "npm",
          "nupkg",
          "crate",
          "pkg",
          "dmg",
          "crx",
          "chm",
          "cab",
          "iso",
          "oci_image",
          "xbps",
          "asar",
          "vsix-archive",
          "xpi",
          "rar",
          "7z",
          "cpio"
        ],
        "conf": 0.9,
        "id": "path-traversal-members",
        "desc": "Archive reports traversal-member paths",
        "crit": "notable",
        "if": {
          "type": "metrics",
          "field": "archive.path_traversal_count",
          "min": 1
        }
      }
    },
    "metadata/package/files/archive-member::archive-parent-path-web-member": {
      "source": "metadata/package/files/archive-member/payload-member.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "unix",
          "windows"
        ],
        "for": [
          "zip",
          "tar",
          "jar",
          "7z",
          "rar"
        ],
        "crit": "notable",
        "conf": 0.9,
        "id": "archive-parent-path-web-member",
        "desc": "Parent-relative archive path targets web content",
        "if": {
          "type": "value",
          "path": "archive.members[*].path",
          "regex": "(?i)(^|/)\\.\\./.{0,200}\\.(php|js|html?|hta)$"
        }
      }
    },
    "metadata/package/files/archive-member::archive-parent-path-server-page-suffix": {
      "source": "metadata/package/files/archive-member/payload-member.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "unix",
          "windows"
        ],
        "for": [
          "zip",
          "tar",
          "jar",
          "7z",
          "rar"
        ],
        "crit": "notable",
        "conf": 0.9,
        "id": "archive-parent-path-server-page-suffix",
        "desc": "Parent-relative member has server-page suffix",
        "if": {
          "type": "value",
          "path": "archive.members[*].path",
          "regex": "(?i)(^|/)\\.\\./.{0,200}\\.(php\\d?|phtml|jsp|asp|aspx|ashx|cer)$"
        }
      }
    },
    "metadata/package/files/archive-member::member-at-least-10mb": {
      "source": "metadata/package/files/archive-member/member-size.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "unix",
          "windows"
        ],
        "for": [
          "7z",
          "tar",
          "zip"
        ],
        "id": "member-at-least-10mb",
        "desc": "Archive member size at least 10 MB",
        "crit": "notable",
        "conf": 0.95,
        "if": {
          "type": "value",
          "path": "archive.members[*].size_bytes",
          "regex": "^[1-9][0-9]{7,}$"
        }
      }
    },
    "metadata/package/files/archive-member::member-at-least-100mb": {
      "source": "metadata/package/files/archive-member/member-size.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "unix",
          "windows"
        ],
        "for": [
          "7z",
          "tar",
          "zip"
        ],
        "id": "member-at-least-100mb",
        "desc": "Archive member size at least 100 MB",
        "crit": "notable",
        "conf": 0.9,
        "if": {
          "type": "value",
          "path": "archive.members[*].size_bytes",
          "regex": "^[1-9][0-9]{8,}$"
        }
      }
    },
    "metadata/file/archive::nupkg-managed-library-layout": {
      "source": "metadata/file/archive/archive.yaml",
      "kind": "composite_rules",
      "effective": {
        "platforms": [
          "windows",
          "linux",
          "macos"
        ],
        "for": [
          "nupkg"
        ],
        "crit": "exception",
        "conf": 0.98,
        "id": "nupkg-managed-library-layout",
        "desc": "NuGet package uses standard managed-library layout",
        "all": [
          {
            "id": "metadata/package/files/nuget::nupkg-managed-library-member"
          }
        ],
        "any": [
          {
            "id": "metadata/package/files/nuget::nupkg-single-executable-member"
          },
          {
            "id": "metadata/package/files/nuget::nupkg-multiple-executable-members"
          }
        ]
      }
    },
    "metadata/file/archive::nupkg-dotnet-tool-layout": {
      "source": "metadata/file/archive/archive.yaml",
      "kind": "composite_rules",
      "effective": {
        "platforms": [
          "windows",
          "linux",
          "macos"
        ],
        "for": [
          "nupkg",
          "xml"
        ],
        "crit": "exception",
        "conf": 0.98,
        "id": "nupkg-dotnet-tool-layout",
        "desc": "NuGet package uses standard .NET tool layout",
        "scope": "outer",
        "all": [
          {
            "id": "metadata/package/entrypoint::dotnet-tool-command-manifest"
          }
        ],
        "any": [
          {
            "id": "metadata/package/files/nuget::nupkg-single-executable-member"
          },
          {
            "id": "metadata/package/files/nuget::nupkg-multiple-executable-members"
          }
        ]
      }
    },
    "metadata/file/archive::rocm-experiment": {
      "source": "metadata/file/archive/archive.yaml",
      "kind": "composite_rules",
      "effective": {
        "platforms": [
          "windows",
          "linux",
          "macos"
        ],
        "for": [
          "zip",
          "tar",
          "jar",
          "whl",
          "python-sdist",
          "gem",
          "deb",
          "rpm",
          "npm",
          "nupkg",
          "crate",
          "pkg",
          "dmg",
          "crx",
          "chm",
          "cab",
          "iso",
          "oci_image",
          "xbps",
          "asar",
          "vsix-archive",
          "xpi",
          "rar",
          "7z",
          "cpio"
        ],
        "crit": "exception",
        "conf": 0.99,
        "id": "rocm-experiment",
        "desc": "ROCm layout experiment",
        "all": [
          {
            "id": "well-known/app/ai/gateway/ollama::ollama-rocm-runtime-member"
          },
          {
            "id": "well-known/app/ai/gateway/ollama::ollama-rocm-kernel-member"
          }
        ]
      }
    },
    "metadata/file/archive::pyinstaller-overlay-exe-toc-entry": {
      "source": "metadata/file/archive/pyinstaller-exe.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "windows"
        ],
        "for": [
          "pe"
        ],
        "id": "pyinstaller-overlay-exe-toc-entry",
        "desc": "CArchive-like binary EXE entry in PE overlay",
        "crit": "notable",
        "conf": 0.9,
        "if": {
          "type": "raw",
          "section": "overlay",
          "regex": "(?i)\\x00[\\x00\\x01][bz][a-z0-9_.-]{1,65}\\.exe\\x00"
        }
      }
    },
    "micro-behaviors/data/parse/vocabulary::reverse-shell-term": {
      "source": "micro-behaviors/data/parse/vocabulary/reverse-shell.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "unix",
          "windows"
        ],
        "for": [
          "scripts",
          "binaries"
        ],
        "id": "reverse-shell-term",
        "desc": "Text names a reverse shell",
        "crit": "notable",
        "conf": 0.7,
        "if": {
          "type": "text",
          "regex": "\\breverse[_.\\s-]?shell\\b",
          "case_insensitive": true
        },
        "unless": [
          {
            "id": "well-known/tool/development/agent/anthropic-claude-agent::claude-agent-native-runtime"
          },
          {
            "id": "well-known/tool/detection/"
          },
          {
            "id": "well-known/app/infrastructure/k9x-satan::attack-fixture-context"
          },
          {
            "id": "well-known/lib/cloud/tencentcloud-dotnet/"
          },
          {
            "type": "text",
            "regex": "(?i)(potential reverse shell|FLAG:.*reverse.?shell)"
          },
          {
            "type": "text",
            "regex": "(?i)\\b(block|deny|drop)\\s+reverse[_.\\s-]?shell\\b"
          },
          {
            "type": "text",
            "regex": "(?i)\\b(prevent|disallow)\\s+reverse[_.\\s-]?shell\\b"
          },
          {
            "type": "text",
            "regex": "(?i)\\bnot\\s+(?:a\\s+)?reverse[_.\\s-]?shell\\b"
          },
          {
            "type": "text",
            "regex": "(?i)\\bcmd=reverse[_.\\s-]?shell\\b"
          }
        ]
      }
    },
    "micro-behaviors/ui/window/form-input::php-command-named-form-control": {
      "source": "micro-behaviors/ui/window/form-input/php-command.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "windows",
          "unix"
        ],
        "crit": "notable",
        "for": [
          "php"
        ],
        "id": "php-command-named-form-control",
        "desc": "HTML form control has a command name",
        "conf": 0.88,
        "if": {
          "type": "text",
          "regex": "<(input|textarea)\\b[^>]{0,100}\\bname=\\\\?[\"'](cmd|command|shell)\\\\?[\"']"
        }
      }
    },
    "micro-behaviors/ui/window/password-field::php-password-input-element": {
      "source": "micro-behaviors/ui/window/password-field/php-element.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "linux",
          "macos",
          "windows"
        ],
        "for": [
          "php"
        ],
        "id": "php-password-input-element",
        "desc": "HTML password form in PHP",
        "crit": "notable",
        "conf": 0.85,
        "if": {
          "type": "text",
          "regex": "<input[^>]{0,120}type=['\"]password['\"]"
        },
        "unless": [
          {
            "id": "well-known/lib/web/server/wordpress-core::wordpress-core-package-doc"
          },
          {
            "id": "well-known/lib/web/server/wordpress-core::wordpress-phpunit-test-case"
          },
          {
            "id": "well-known/lib/web/server/wordpress-core::wordpress-core-include-bootstrap"
          }
        ],
        "downgrade": {
          "any": [
            {
              "id": "well-known/lib/web/server/wordpress-core::wordpress-core-api-symbols"
            }
          ]
        }
      }
    },
    "metadata/file/archive::tiny-rar5-container": {
      "source": "metadata/file/archive/archive.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "windows",
          "linux",
          "macos"
        ],
        "for": [
          "rar"
        ],
        "crit": "notable",
        "conf": 0.9,
        "id": "tiny-rar5-container",
        "desc": "RAR5 container at most 256 bytes",
        "size_max": 256,
        "if": {
          "type": "hex",
          "pattern": "52 61 72 21 1A 07 01 00",
          "offset": 0
        }
      }
    },
    "metadata/file/archive::tiny-rar4-container": {
      "source": "metadata/file/archive/archive.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "windows",
          "linux",
          "macos"
        ],
        "for": [
          "rar"
        ],
        "crit": "notable",
        "conf": 0.9,
        "id": "tiny-rar4-container",
        "desc": "RAR4 container at most 256 bytes",
        "size_max": 256,
        "if": {
          "type": "hex",
          "pattern": "52 61 72 21 1A 07 00",
          "offset": 0
        }
      }
    }
  }
}
