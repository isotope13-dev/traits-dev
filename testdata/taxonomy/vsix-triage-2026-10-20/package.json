{
    "name": "fixline-tool",
    "displayName": "Fixline tool",
    "description": "Fixline tool",
    "version": "1.3.0",
    "publisher": "Danil",
    "preview": false,
    "icon": "images/fixline.png",
    "repository": {
        "url": "https://github.com/Finist02/Fixline_tool",
        "type": "git"
    },
    "engines": {
        "vscode": "^1.93.0"
    },
    "categories": [
        "Other",
        "Programming Languages"
    ],
    "keywords": [
        "ctrl",
        "ctrlpp",
        "ctrl++",
        "Kaskad",
        "ScadCC"
    ],
    "main": "./out/extension.js",
    "activationEvents": [],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "dpes-explorer",
                    "title": "Dpes Explorer",
                    "icon": "media/dep.svg",
                    "when": "config.FixLineTool.DpeServer.EnableDpeExplorer"
                }
            ]
        },
        "views": {
            "dpes-explorer": [
                {
                    "id": "ctrlDpsTree",
                    "name": "DPES EXPLORER",
                    "icon": "media/dep.svg",
                    "contextualTitle": "Dpes explorer",
                    "canSelectMany": false,
                    "when": "config.FixLineTool.DpeServer.EnableDpeExplorer"
                },
                {
                    "id": "dpeFavorites",
                    "name": "DPE FAVORITES",
                    "icon": "$(star)",
                    "contextualTitle": "DPE Favorite Items",
                    "canSelectMany": false,
                    "when": "config.FixLineTool.DpeServer.EnableDpeExplorer"
                }
            ]
        },
        "languages": [
            {
                "id": "ctrl",
                "extensions": [
                    ".ctl"
                ],
                "aliases": [
                    "Ctrl",
                    "ctrl"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "ctrlpp",
                "extensions": [
                    ".ctl"
                ],
                "aliases": [
                    "Ctrl++",
                    "Ctrlpp",
                    "ctrlpp"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "ctrl",
                "scopeName": "source.ctrl",
                "path": "./syntaxes/ctrl.tmLanguage.json"
            },
            {
                "language": "ctrlpp",
                "scopeName": "source.ctrlpp",
                "path": "./syntaxes/ctrlpp.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "ctrl",
                "path": "./snippets/ctrl.json"
            },
            {
                "language": "ctrlpp",
                "path": "./snippets/ctrl.json"
            },
            {
                "language": "ctrlpp",
                "path": "./snippets/ctrlpp.json"
            },
            {
                "language": "ctrlpp",
                "path": "./snippets/doxygen.json"
            }
        ],
        "commands": [
            {
                "command": "ctrlDpsTree.refreshEntry",
                "title": "Refresh",
                "icon": "$(refresh)",
                "enablement": "config.FixLineTool.DpeServer.EnableDpeExplorer"
            },
            {
                "command": "ctrlDpsTree.searchDpe",
                "title": "🔍 Search DPE",
                "icon": "$(search)",
                "enablement": "config.FixLineTool.DpeServer.EnableDpeExplorer"
            },
            {
                "command": "ctrlDpsTree.viewHistory",
                "title": "📊 Show DPE History",
                "icon": "$(graph)",
                "enablement": "config.FixLineTool.DpeServer.EnableDpeExplorer"
            },
            {
                "command": "ctrlDpsTree.copyId",
                "title": "📋 Copy ID",
                "icon": "$(clippy)",
                "enablement": "config.FixLineTool.DpeServer.EnableDpeExplorer"
            },
            {
                "command": "ctrlDpsTree.addToFavorites",
                "title": "⭐ Add to Favorites",
                "icon": "$(star)",
                "enablement": "config.FixLineTool.DpeServer.EnableDpeExplorer"
            },
            {
                "command": "dpeFavorites.refresh",
                "title": "Refresh Favorites",
                "icon": "$(refresh)",
                "enablement": "config.FixLineTool.DpeServer.EnableDpeExplorer"
            },
            {
                "command": "dpeFavorites.removeFromFavorites",
                "title": "⭐ Remove from Favorites",
                "icon": "$(star-full)",
                "enablement": "config.FixLineTool.DpeServer.EnableDpeExplorer"
            },
            {
                "command": "extension.OpenUnitTest",
                "title": "Open UnitTest",
                "icon": "$(preview)",
                "category": "Fixline"
            },
            {
                "command": "extension.CreateChildClass",
                "title": "Create child class",
                "icon": "$(preview)",
                "category": "Fixline"
            },
            {
                "command": "extension.OpenPanel",
                "title": "Open panel",
                "icon": "$(preview)",
                "category": "Fixline"
            },
            {
                "command": "extension.OpenHelpCtrl",
                "title": "Open ctrl Help",
                "icon": "$(book)",
                "category": "Fixline"
            },
            {
                "command": "extension.OpenProjectPanel",
                "title": "Open project panel",
                "icon": "$(preview)",
                "category": "Fixline"
            },
            {
                "command": "extension.OpenProjectPanelWithAdditionalDollars",
                "title": "Open project panel with additional dollars",
                "icon": "$(preview)",
                "category": "Fixline"
            },
            {
                "command": "extension.OpenProjectPanelWithDebug",
                "title": "Open project panel with debug",
                "icon": "$(preview)",
                "category": "Fixline"
            },
            {
                "command": "extension.CheckScript",
                "title": "Check Script",
                "icon": "$(debug)",
                "category": "Fixline"
            },
            {
                "command": "extension.CreateChangelog",
                "title": "Create changelog",
                "icon": "$(debug)",
                "category": "Fixline"
            },
            {
                "command": "extension.CreateDoxyHelp",
                "title": "Create help doxygen",
                "icon": "$(debug)",
                "category": "Fixline"
            },
            {
                "command": "extension.GetHelpChatGpt",
                "title": "Get help Ctrlpp",
                "icon": "$(debug)",
                "category": "Fixline"
            },
            {
                "command": "extension.RunScript",
                "title": "Run script",
                "icon": "$(run)",
                "category": "Fixline"
            },
            {
                "command": "extension.OpenLogs",
                "title": "Open Log",
                "icon": "$(list-flat)",
                "category": "Fixline"
            },
            {
                "command": "extension.Panelpreview",
                "title": "Panel preview",
                "icon": "$(open-preview)",
                "category": "Fixline"
            },
            {
                "command": "extension.StartUnitTests",
                "title": "Start tests",
                "category": "Fixline"
            },
            {
                "command": "extension.OpenSqlTool",
                "title": "Open SQL Query Tool",
                "icon": "$(database)",
                "category": "Fixline",
                "enablement": "config.FixLineTool.DpeServer.EnableDpeExplorer"
            },
            {
                "command": "extension.CreateUMLDiagrams",
                "title": "Create UML diagrams",
                "category": "Fixline"
            },
            {
                "command": "extension.OpenProject",
                "title": "Open Project",
                "category": "Fixline"
            },
            {
                "command": "extension.LoadDPL",
                "title": "Load dpl",
                "icon": "$(preview)",
                "category": "Fixline"
            },
            {
                "command": "extension.ViewDplAsTable",
                "title": "View DPL as Table",
                "icon": "$(table)",
                "category": "Fixline"
            },
            {
                "command": "extension.CopyResources",
                "title": "Copy Cursor Rules and Documentation resources to Workspace Folders",
                "icon": "$(file-directory)",
                "category": "Fixline"
            },
            {
                "command": "extension.CopyCopilotResources",
                "title": "Copy GitHub Copilot Instructions and Documentation resources to Workspace Folders",
                "icon": "$(github)",
                "category": "Fixline"
            },
            {
                "command": "extension.ShowErrorLogs",
                "title": "Show Error Logs",
                "icon": "$(output)",
                "category": "Fixline"
            },
            {
                "command": "extension.ScanDiagnosticsInFolders",
                "title": "Scan Diagnostics In Folders",
                "icon": "$(search)",
                "category": "Fixline"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "ctrlDpsTree.refreshEntry",
                    "when": "view == ctrlDpsTree && config.FixLineTool.DpeServer.EnableDpeExplorer",
                    "group": "navigation@1"
                },
                {
                    "command": "ctrlDpsTree.searchDpe",
                    "when": "view == ctrlDpsTree && config.FixLineTool.DpeServer.EnableDpeExplorer",
                    "group": "navigation@2"
                },
                {
                    "command": "extension.OpenSqlTool",
                    "when": "view == ctrlDpsTree && config.FixLineTool.DpeServer.EnableDpeExplorer",
                    "group": "navigation@3"
                },
                {
                    "command": "dpeFavorites.refresh",
                    "when": "view == dpeFavorites && config.FixLineTool.DpeServer.EnableDpeExplorer",
                    "group": "navigation@1"
                }
            ],
            "view/item/context": [
                {
                    "command": "ctrlDpsTree.addToFavorites",
                    "when": "view == ctrlDpsTree && viewItem == dpel && config.FixLineTool.DpeServer.EnableDpeExplorer",
                    "group": "inline"
                },
                {
                    "command": "ctrlDpsTree.copyId",
                    "when": "view == ctrlDpsTree && config.FixLineTool.DpeServer.EnableDpeExplorer",
                    "group": "navigation@1"
                },
                {
                    "command": "dpeFavorites.removeFromFavorites",
                    "when": "view == dpeFavorites && viewItem == favorite-item && config.FixLineTool.DpeServer.EnableDpeExplorer",
                    "group": "inline"
                }
            ],
            "explorer/context": [
                {
                    "command": "extension.OpenPanel",
                    "when": "resourceExtname == .xml",
                    "group": "navigation@6"
                },
                {
                    "command": "extension.Panelpreview",
                    "when": "resourceExtname == .xml",
                    "group": "navigation@6"
                },
                {
                    "command": "extension.CheckScript",
                    "when": "resourceExtname == .ctl",
                    "group": "navigation@6"
                },
                {
                    "command": "extension.RunScript",
                    "when": "resourceExtname == .ctl",
                    "group": "navigation@6"
                }
            ],
            "editor/title": [
                {
                    "command": "extension.OpenPanel",
                    "group": "navigation",
                    "when": "resourceExtname == .xml"
                },
                {
                    "command": "extension.Panelpreview",
                    "group": "navigation",
                    "when": "resourceExtname == .xml"
                },
                {
                    "command": "extension.CheckScript",
                    "group": "navigation",
                    "when": "resourceExtname == .ctl"
                },
            {
                "command": "extension.RunScript",
                "group": "navigation",
                "when": "resourceExtname == .ctl"
            },
            {
                "command": "extension.ViewDplAsTable",
                "group": "navigation",
                "when": "resourceExtname == .dpl"
            }
            ]
        },
        "configuration": [
            {
                "type": "object",
                "title": "Fixline tool",
                "properties": {
                    "FixLineTool.Syntax.CheckSyntax": {
                        "type": "boolean",
                        "default": false,
                        "description": "Check syntax"
                    },
                    "FixLineTool.Syntax.KnownItems": {
                        "type": "array",
                        "default": [],
                        "description": "Known items"
                    },
                    "FixLineTool.Syntax.InnersReadFiles": {
                        "type": "number",
                        "default": 2,
                        "description": "Deep read files"
                    },
                    "FixLineTool.Syntax.HighlightCommentDoxygen": {
                        "type": "boolean",
                        "default": false,
                        "description": "Highlight comment Doxygen"
                    },
                    "FixLineTool.CodeLens.AutoAddDoxygenComment": {
                        "type": "boolean",
                        "default": true,
                        "description": "Enable/disable Code Lens suggestion for auto-adding Doxygen comments"
                    },
                    "FixLineTool.Syntax.UsesLibraryFunctions": {
                        "type": "object",
                        "default": {},
                        "description": "Functions per #uses library (e.g. for DLLs). Map: library name -> list of function names. Example: {\"CtrlXml\": [\"xmlDocumentFromString\"], \"MyDll\": [\"myFunc\"]}",
                        "additionalProperties": {
                            "type": "array",
                            "items": { "type": "string" }
                        }
                    },
                    "FixLineTool.OpenPanel.UserName": {
                        "type": "string",
                        "default": "root",
                        "description": "User Name"
                    },
                    "FixLineTool.OpenPanel.Dollars": {
                        "type": "string",
                        "default": "",
                        "description": "Dollars"
                    },
                    "FixLineTool.OpenPanel.Password": {
                        "type": "string",
                        "default": "",
                        "description": "Password"
                    },
                    "FixLineTool.Gitlab.GitlabUrl": {
                        "type": "string",
                        "default": "",
                        "description": "GitlabUrl"
                    },
                    "FixLineTool.ProgramPath.PvssFolderPath": {
                        "type": "string",
                        "default": "C:/ProgramData/Sybcom/Kaskad",
                        "description": "PvssFolderPath"
                    },
                    "FixLineTool.DpeServer.EnableDpeExplorer": {
                        "type": "boolean",
                        "default": true,
                        "description": "Enable/disable DPE Explorer and related features"
                    },
                    "FixLineTool.DpeServer.ServerUrl": {
                        "type": "string",
                        "default": "http://localhost:5080",
                        "description": "DPE server URL for API connection (default: http://localhost:5080)",
                        "when": "config.FixLineTool.DpeServer.EnableDpeExplorer"
                    }
                }
            }
        ]
    },
    "capabilities": {
        "definitionProvider": "true"
    },
    "scripts": {
        "generate": "npx antlr4ts-cli -visitor -o src/grammar grammar/ControlParser.g4 grammar/ControlLexer.g4",
        "vscode:prepublish": "npm run compile && npx javascript-obfuscator ./out --output ./out",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "test:vector-bracket": "node ./out/test/runTest.js --grep \"VectorBracketSpacing|vector.*bracket|bracket.*spacing\"",
        "test:const-params": "node ./out/test/runTest.js --grep \"константные параметры|const.*param|parameter.*const\"",
        "package": "npm run compile && npx @vscode/vsce package"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.7",
        "@types/node": "20.x",
        "@types/vscode": "^1.93.0",
        "@typescript-eslint/eslint-plugin": "^8.3.0",
        "@typescript-eslint/parser": "^8.3.0",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.4.1",
        "antlr4ts-cli": "^0.5.0-alpha.4",
        "eslint": "^9.9.1",
        "glob": "^11.1.0",
        "typescript": "^5.5.4"
    },
    "dependencies": {
        "axios": "^1.13.5",
        "braces": "^3.0.3",
        "fs": "^0.0.1-security",
        "fsp-xml-parser": "^1.0.0",
        "highlight.js": "^11.8.0",
        "javascript-obfuscator": "^4.1.1",
        "antlr4ts": "^0.5.0-alpha.4",
        "markdown-it": "^14.1.1",
        "os": "^0.1.2",
        "punycode": "^2.3.1",
        "xml2js": "^0.6.2"
    },
    "overrides": {
        "validator": "^13.15.20",
        "diff": "^5.2.2",
        "@isaacs/brace-expansion": "^5.0.1",
        "minimatch": "^10.2.1",
        "ajv": "^6.14.0"
    }
}