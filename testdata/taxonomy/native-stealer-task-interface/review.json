{
  "sample_sha256": "39c02cc43c456424cee291e821d9cb73775df4c67a2159e591891cefc15fcf59",
  "identification": "Comandos native x64 MinGW C++ RAT task module",
  "verdict": "MALICIOUS",
  "evidence": [
    {
      "entry": "0x28d5a67d1 ExecuteSpecialCommand",
      "effect": "Accepts command, token and working directory from caller; dispatches !stealer, !winlocker or !weblive; posts result to /upload/terminal. No network polling is implemented in this DLL."
    },
    {
      "entry": "0x28d5a4b3b CommandStealer",
      "effect": "Downloads bytes through WinInet, creates hidden tmp_<PID>.exe in the supplied directory, writes the bytes, starts that same file with argument all and CREATE_NO_WINDOW, waits up to 60 seconds, deletes the executable, then uploads and removes its output directory."
    },
    {
      "entry": "0x28d5a3e33 EnviarTodasPastasNavegadores",
      "effect": "Enumerates output subdirectories and their Default directories, calls recursive upload routine."
    },
    {
      "entry": "0x28d5a353a EnviarArquivosRecursivamente",
      "effect": "Recurses output directories, selects filenames containing .json, derives numbered browser/file upload names and passes each path to file upload routine."
    },
    {
      "entry": "0x28d5a312c EnviarArquivoParaPainel",
      "effect": "Reads the entire file through CreateFileA/ReadFile into a string and passes those bytes to HttpRequest with /upload?filename= and X-Stealer-Upload: true."
    },
    {
      "entry": "0x28d5a2af7 HttpRequest",
      "effect": "Connects to configured server on HTTPS port 443, sends buffer with HttpSendRequestA. Adds bearer token, machine and username in X-Machine-ID and machine=, and octet-stream content type for POST data."
    },
    {
      "entry": "0x28d5a5993 CommandWeblive",
      "effect": "Checks process list, downloads a missing executable into a vendor-looking Local Temp directory, builds PowerShell Start-Process using that same path and caller token, creates hidden child. The DLL itself does not implement screen capture."
    },
    {
      "entry": "0x28d5a40f4 CommandWinlocker",
      "effect": "Downloads a locker payload to Local Temp, then executes that same path using hidden ShellExecuteExA. Hash verification helper exists but expected hash is initialized empty, bypassing the check. No file encryption or actual screen lock is implemented in this DLL."
    },
    {
      "entry": "0x28d5a75df DllMain",
      "effect": "Creates/logs a diagnostics path and disables thread notifications; theft runs only when the exported task interface is called."
    }
  ],
  "refuted_or_limited_claims": [
    "No packing, string encryption or obscured custom-code control flow was found. ASCII strings, COFF symbols and DWARF identify ordinary native code.",
    "The 1.6 MiB apparent overlay begins with the COFF symbol table and continues into its string table; it is not evidence of a hidden payload.",
    "PE-header reads and VirtualProtect are present in runtime support. They do not establish reflective injection, evasion or privilege escalation.",
    "Generic X-*-Upload, machine identity and POST markers also describe ordinary upload clients. They no longer imply hostile exfiltration.",
    "URLMon download and hidden Start-Process strings alone do not bind a downloaded path to execution. The old hostile inference is now a neutral co-occurrence observation."
  ],
