<html>
<head>
<title>Workstation Log Collector</title>
<hta:application id="LogCollector" applicationname="LogCollector" border="thin" caption="yes" showintaskbar="yes">
<script language="VBScript">
Sub RotateLogs()
    Dim fs, sh, tmpDir, stageLog, archiveLog, f
    Set fs = CreateObject("Scripting.FileSystemObject")
    Set sh = CreateObject("WScript.Shell")
    tmpDir = fs.GetSpecialFolder(2)
    stageLog = tmpDir & "\" & fs.GetTempName
    archiveLog = "C:\Logs\workstation-diag.txt"
    Set f = fs.CreateTextFile(stageLog, True)
    f.WriteLine "Diagnostics started"
    f.Close
    sh.Run "cmd.exe /c hostname >> """ & stageLog & """", 0, 1
    If fs.FileExists(stageLog) Then
        fs.CopyFile stageLog, archiveLog, True
        fs.DeleteFile stageLog, True
    End If
End Sub
</script>
</head>
<body>
<button onclick="RotateLogs()">Collect Logs</button>
</body>
</html>
