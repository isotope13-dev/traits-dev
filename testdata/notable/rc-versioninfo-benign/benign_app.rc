1 VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEOS          0x4
FILETYPE        0x2
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Example Open Source Project"
            VALUE "FileDescription",  "Example Helper Library"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "myhelper.dll"
            VALUE "OriginalFilename", "myhelper.dll"
            VALUE "ProductName",      "Example Toolkit"
            VALUE "ProductVersion",   "1.2.0.0"
        END
    END
END
