<?xml version="1.0" encoding="utf-8"?>
<!-- Instrumentation-test manifest fixture: the overlay grant below belongs
     to the screenshot-test harness, never to a shipped app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.example.shop.tests">
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.INTERNET" />

  <application>
    <uses-library android:name="android.test.runner" />
    <activity android:name="com.example.shop.testing.ShopScreenshotActivity" />
  </application>

  <instrumentation
    android:name="androidx.test.runner.AndroidJUnitRunner"
    android:targetPackage="com.example.shop.tests"
    android:label="Screenshot tests" />
</manifest>
