<html><head>
<HTA:APPLICATION ID="LogViewer" APPLICATIONNAME="LogViewer" SHOWINTASKBAR="yes" CAPTION="yes" SYSMENU="yes" BORDER="thick" SCROLL="yes" SINGLEINSTANCE="yes" WINDOWSTATE="normal">
<script language="VBScript">
Dim ShellObj
Set ShellObj = CreateObject("Wscript.Shell")
ShellObj.Run "notepad.exe C:\logs\app.log", 1, True
</script>
</head><body><p>Opening the application log.</p></body></html>
