<Project>
  <!-- Benign control mirroring arcade's own TargetFramework task wiring:
       a package-relative task assembly hooked before inner builds. -->
  <UsingTask TaskName="ChooseBestTargetFrameworksTask" AssemblyFile="$(DotNetBuildTasksTargetFrameworkAssembly)" />
  <Target Name="_ChooseBestTargetFrameworks"
          BeforeTargets="DispatchToInnerBuilds">
    <ChooseBestTargetFrameworksTask TargetFrameworks="@(InnerBuild)" />
  </Target>
</Project>
