{
  "eligible_parent_consumers": [
    {
      "file": "metadata/file/string/identity/source-tokens.yaml",
      "rule": {
        "id": "chunk-token",
        "crit": "notable",
        "desc": "Bundler chunk identifier",
        "if": {
          "type": "text",
          "regex": "(?i)webpackchunk|chunkid|chunkloa|chunk-vendors"
        },
        "unless": [
          {
            "id": "well-known/app/"
          },
          {
            "id": "well-known/lib/"
          },
          {
            "id": "well-known/tool/"
          }
        ]
      },
      "defaults": {
        "platforms": [
          "windows",
          "unix"
        ],
        "for": [
          "scripts",
          "source"
        ],
        "crit": "component",
        "conf": 0.95
      }
    },
    {
      "file": "micro-behaviors/fs/path/vcs/triage-neutral-traits.yaml",
      "rule": {
        "for": [
          "source",
          "scripts"
        ],
        "id": "source-control-config-or-token-path-reference",
        "desc": "Source control credential paths",
        "conf": 0.9,
        "if": {
          "type": "text",
          "regex": "(\\.git-credentials|\\.config/gh/hosts\\.yml|\\.gitconfig)\\b"
        },
        "unless": [
          {
            "id": "metadata/build/"
          }
        ]
      },
      "defaults": {
        "platforms": [
          "unix",
          "windows"
        ],
        "crit": "notable"
      }
    },
    {
      "file": "micro-behaviors/fs/read/file/target/git.yaml",
