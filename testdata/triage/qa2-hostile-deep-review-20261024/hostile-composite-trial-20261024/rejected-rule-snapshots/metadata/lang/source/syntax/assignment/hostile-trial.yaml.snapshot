# Experimental structural filters. This copy is never a production ruleset.
defaults:
  for: [javascript]
  platforms: [windows, unix]
  crit: notable
traits:
  - id: trial-zero-arg-export-config-object
    desc: CommonJS zero-argument factory returns URL fields
    conf: 0.99
    if:
      type: tree-sitter
      language: javascript
      query: |
        ((assignment_expression
          left: (member_expression object: (identifier) @owner property: (property_identifier) @export)
          right: (arrow_function parameters: (formal_parameters) @params
            body: (statement_block
              (return_statement (object
                (pair key: (property_identifier) @mirror value: (string) @empty)
                (pair key: (property_identifier) @server value: (string)))))))
          (#eq? @owner "module")
          (#eq? @export "exports")
          (#match? @params "^[(][ \\t\\r\\n]*[)]$")
          (#eq? @mirror "mirror_url")
          (#eq? @server "server_url")
          (#match? @empty "^[\"'][\"']$"))
  - id: trial-source-has-no-call-expressions
    desc: Source contains zero call expressions
    conf: 0.99
    if:
      type: metrics
      field: ast.call_count
      min: 0
      max: 0
  - id: trial-source-has-empty-string
    desc: Source contains an empty string literal
    conf: 0.99
    if:
      type: metrics
      field: strings.empty_count
      min: 1
