index 186a8cb..332befe 100644
--- a/src/formats/markdown.rs
+++ b/src/formats/markdown.rs
@@ -168,13 +168,35 @@ fn parse_atx_heading(line: &str) -> Option<String> {
 }
 
 /// Strip inline emphasis markers (`*`, `_`, backticks) from a heading.
-/// We don't reconstruct nested emphasis — we just remove the marker
-/// bytes so `**Foo**` and `` `bar` `` read as `Foo` and `bar`.
+/// We don't reconstruct nested emphasis. Remove formatting markers so
+/// `**Foo**` and `` `bar` `` read as `Foo` and `bar`, while preserving
+/// intraword underscore runs that cannot be emphasis delimiters.
 fn strip_inline_emphasis(s: &str) -> String {
-    let stripped: String = s
-        .chars()
-        .filter(|c| !matches!(c, '*' | '_' | '`'))
-        .collect();
+    let chars: Vec<char> = s.chars().collect();
+    let mut stripped = String::new();
+    let mut cursor = 0;
+    while cursor < chars.len() {
+        if chars[cursor] == '_' {
+            let start = cursor;
+            while cursor < chars.len() && chars[cursor] == '_' {
+                cursor += 1;
+            }
+            // CommonMark forbids intraword underscore emphasis. Preserve the
+            // entire run in names such as `@scope/foo__bar` and `foo_bar`.
+            if start > 0
+                && chars[start - 1].is_alphanumeric()
+                && cursor < chars.len()
+                && chars[cursor].is_alphanumeric()
+            {
+                stripped.extend(chars[start..cursor].iter());
+            }
+        } else {
+            if !matches!(chars[cursor], '*' | '`') {
+                stripped.push(chars[cursor]);
+            }
+            cursor += 1;
+        }
+    }
     stripped.trim().to_owned()
 }
 
diff --git a/src/formats/markdown/tests.rs b/src/formats/markdown/tests.rs
index 4b51e8c..130ece5 100644
--- a/src/formats/markdown/tests.rs
+++ b/src/formats/markdown/tests.rs
@@ -365,3 +365,27 @@ fn handles_invalid_utf8_gracefully() {
         Some("Heading")
     );
 }
+
+#[test]
+fn first_heading_preserves_intraword_underscores() {
+    for name in [
+        "@depup/aws-sdk__credential-provider-process",
+        "@scope/foo_bar",
+        "plain__package",
+        "módulo_nome",
+    ] {
+        for heading in [format!("# {name}\n"), format!("# **{name}**\n")] {
+            let v = run(&heading);
+            assert_eq!(get_str(&v, "markdown.first_heading").as_deref(), Some(name));
+        }
+    }
+}
+
+#[test]
+fn first_heading_still_strips_underscore_emphasis() {
+    let v = run("# __Bold__ _and_ **text**\n");
+    assert_eq!(
+        get_str(&v, "markdown.first_heading").as_deref(),
+        Some("Bold and text")
+    );
+}
