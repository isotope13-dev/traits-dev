      "@lancedb/lancedb-win32-x64-msvc": "0.27.2"
    },
    "devDependencies": {
      "@modelcontextprotocol/client": "^2.0.0",
      "@types/node": "^22.15.2"
    },
    "repository": {
      "type": "git",
