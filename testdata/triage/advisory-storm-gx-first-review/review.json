  "rule_corrections": [
    {
      "rule": "metadata/package/documentation/security-advisory::osv-advisory-report-structure",
      "reason": "Require advisory schema, identifier, prose, affected ecosystem and advisory-reference fields; reject task/script/fsspec carrier fields. Use file-scoped suppressions, preserving adjacent executable members."
    },
    {
      "rule": "objectives/command-and-control/backdoor/binary::unsigned-dotnet-http-registry-stager",
      "action": "Removed unsupported hostile composite",
      "reason": "Unsigned .NET metadata, a blank vendor, HTTP APIs/URLs and RegistryKey references do not bind fetched bytes to execution or establish a remote-control surface. All six supported constituent observations remain."
    },
    {
      "rule": "objectives/anti-static/obfuscation/binary-metrics/imports::huge-file-tiny-imports",
      "action": "Replace with metadata/binary/symbols/imports::image-over-10mb-at-most-25-imports",
      "reason": "File size/import count and optional dynamic/crypto/shell APIs do not establish concealment. Preserve the measured property without inferring intent; the neutral observation intentionally includes files previously excluded by product or API context."
    },
    {
      "rule": "micro-behaviors/communications/http/get::go-native-http-get-reference",
      "reason": "Existing extracted-text equality missed the real Go pclntab API name adjoining binary records. A NUL-delimited YARA byte string recovers the method reference and rejects longer method names; it does not claim a request solely from a reference."
    }
  ],
