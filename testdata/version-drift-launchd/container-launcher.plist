<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>org.example.worker</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>podman network create app-net 2&gt;/dev/null; podman run --rm --network app-net -p 127.0.0.1:8765:8765 example/service:stable</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
