{
  "rules": [
    {
      "old": "metadata/file/archive::npm-compressed-wrapper-parse-error",
      "new": "metadata/file/archive::npm-package-parse-error",
      "before": {
        "platforms": [
          "windows",
          "linux"
        ],
        "for": [
          "npm"
        ],
        "crit": "baseline",
        "conf": 0.95,
        "id": "npm-compressed-wrapper-parse-error",
        "desc": "npm gzip wrapper parse error",
        "unless": [
          {
            "type": "value",
            "path": "package.json::name",
            "exists": false
          }
        ],
        "if": {
          "type": "metrics",
          "field": "parse.error_count",
          "min": 1
        }
      },
      "after": {
        "platforms": [
          "windows",
          "linux"
        ],
        "for": [
          "npm"
        ],
        "crit": "baseline",
        "conf": 0.95,
        "id": "npm-package-parse-error",
        "desc": "npm package archive reports parser errors",
        "unless": [
          {
            "id": "metadata/package/name/convention::npm-archive-name-missing"
          }
        ],
        "all": [
          {
            "id": "metadata/file/archive::archive-parser-errors-present"
          }
        ]
      }
    },
    {
      "old": "metadata/file/archive::archive-parse-error",
      "new": "metadata/file/archive::archive-parse-error",
      "before": {
        "platforms": [
          "windows",
          "linux"
        ],
        "for": [
          "zip",
          "tar",
          "jar",
          "whl",
          "python-sdist",
          "gem",
          "deb",
          "rpm",
          "npm",
          "nupkg",
          "crate",
          "pkg",
          "dmg",
          "crx",
          "chm",
          "cab",
          "iso",
          "oci_image",
          "xbps",
          "asar",
          "vsix-archive",
          "xpi",
          "rar",
          "7z",
          "cpio"
        ],
        "crit": "baseline",
        "conf": 0.9,
        "id": "archive-parse-error",
        "desc": "Archive parser reported errors",
        "unless": [
          {
            "type": "basename",
            "regex": "(?i)\\.(tar\\.(gz|bz2|xz|zst)|t(gz|bz2|xz|zst))$"
          },
          {
            "type": "basename",
            "regex": "(?i)\\.crate$"
          },
          {
            "type": "value",
            "path": "archive.format.kind",
            "exact": "pkg"
          },
          {
            "id": "metadata/build/archive::source-archive-member"
          },
          {
            "type": "raw",
            "substr": ".."
          },
          {
            "type": "hex",
            "pattern": "50 4B 03 04 [26] (2F|5C)"
          },
          {
            "type": "hex",
            "pattern": "50 4B 03 04 [26] ?? 3A (2F|5C)"
          }
        ],
        "if": {
          "type": "metrics",
          "field": "parse.error_count",
          "min": 1
        }
      },
      "after": {
        "platforms": [
          "windows",
          "linux"
        ],
        "for": [
          "zip",
          "tar",
          "jar",
          "whl",
          "python-sdist",
          "gem",
          "deb",
          "rpm",
          "npm",
          "nupkg",
          "crate",
          "pkg",
          "dmg",
          "crx",
          "chm",
          "cab",
          "iso",
          "oci_image",
          "xbps",
          "asar",
          "vsix-archive",
          "xpi",
          "rar",
          "7z",
          "cpio"
        ],
        "crit": "baseline",
        "conf": 0.9,
        "id": "archive-parse-error",
        "desc": "Archive errors outside recognized wrappers",
        "unless": [
          {
            "id": "metadata/file/extension/package::compressed-tar-basename"
          },
          {
            "id": "metadata/file/extension/package::rust-crate-basename"
          },
          {
            "id": "metadata/file/format/structured::archive-format-pkg"
          },
          {
            "id": "metadata/build/archive::source-archive-member"
          },
          {
            "id": "metadata/package/files/archive-member::path-traversal-members"
          },
          {
            "id": "metadata/package/files/archive-member::absolute-path-member"
          },
          {
            "id": "metadata/package/files/archive-member::backslash-rooted-member"
          },
          {
            "id": "metadata/package/files/archive-member::drive-rooted-member"
          }
        ],
        "all": [
          {
            "id": "metadata/file/archive::archive-parser-errors-present"
          }
        ]
      }
    }
  ],
  "guards": [
    {
      "canonical": "metadata/package/name/convention::npm-archive-name-missing",
      "source": "metadata/package/name/convention/archive-manifest.yaml",
      "effective": {
        "for": [
          "npm"
        ],
        "platforms": [
          "windows",
          "linux"
        ],
        "id": "npm-archive-name-missing",
        "desc": "npm archive has no parsed package name",
        "crit": "baseline",
        "conf": 0.9,
        "if": {
          "type": "value",
          "path": "package.json::name",
          "exists": false
        }
      }
    },
    {
      "canonical": "metadata/file/extension/package::compressed-tar-basename",
      "source": "metadata/file/extension/package/parser-wrapper.yaml",
      "effective": {
        "for": [
          "tar",
          "npm",
          "crate",
          "python-sdist",
          "gem",
          "xbps",
          "gentoo_binpkg"
        ],
        "platforms": [
          "windows",
          "linux"
        ],
        "id": "compressed-tar-basename",
        "desc": "Compressed-tar suffix in archive basename",
        "crit": "baseline",
        "conf": 0.9,
        "if": {
          "type": "basename",
          "regex": "(?i)\\.(tar\\.(gz|bz2|xz|zst)|t(gz|bz2|xz|zst))$"
        }
      }
    },
    {
      "canonical": "metadata/file/extension/package::rust-crate-basename",
      "source": "metadata/file/extension/package/traits.yaml",
      "effective": {
        "platforms": [
          "windows",
          "unix"
        ],
        "id": "rust-crate-basename",
        "desc": "Archive basename has a .crate suffix",
        "crit": "baseline",
        "conf": 0.95,
        "for": [
          "crate"
        ],
        "if": {
          "type": "basename",
          "regex": "(?i)\\.crate$"
        }
      }
    },
    {
      "canonical": "metadata/file/format/structured::archive-format-pkg",
      "source": "metadata/file/format/structured/package-wrapper.yaml",
      "effective": {
        "for": [
          "pkg"
        ],
        "platforms": [
          "unix",
          "windows"
        ],
        "id": "archive-format-pkg",
        "desc": "Archive parser identifies a pkg wrapper",
        "crit": "baseline",
        "conf": 0.98,
        "if": {
          "type": "value",
          "path": "archive.format.kind",
          "exact": "pkg"
        }
      }
    },
    {
      "canonical": "metadata/build/archive::source-archive-member",
      "source": "metadata/build/archive/source.yaml",
      "effective": {
        "platforms": [
          "windows",
          "linux"
        ],
        "for": [
          "tar",
          "zip",
          "7z",
          "rar",
          "cpio",
          "shell",
          "dockerfile",
          "python",
          "-crate"
        ],
        "id": "source-archive-member",
        "desc": "Source archive member context",
        "crit": "baseline",
        "conf": 0.9,
        "any": [
          {
            "id": "go-module-proxy-source-archive-member"
          },
          {
            "id": "go-module-proxy-version-archive-member"
          },
          {
            "id": "github-release-source-archive-member"
          },
          {
            "id": "github-versioned-source-archive-member"
          },
          {
            "id": "versioned-source-tree-archive-member"
          },
          {
            "id": "versioned-source-release-tarball"
          },
          {
            "id": "branch-named-source-archive-context"
          },
          {
            "id": "branch-named-source-archive-member"
          }
        ],
        "unless": [
          {
            "id": "metadata/file/extension/package::rust-crate-basename"
          }
        ]
      }
    },
    {
      "canonical": "metadata/package/files/archive-member::path-traversal-members",
      "source": "metadata/package/files/archive-member/shape.yaml",
      "effective": {
        "platforms": [
          "windows",
          "linux"
        ],
        "for": [
          "zip",
          "tar",
          "jar",
          "whl",
          "python-sdist",
          "gem",
          "deb",
          "rpm",
          "npm",
          "nupkg",
          "crate",
          "pkg",
          "dmg",
          "crx",
          "chm",
          "cab",
          "iso",
          "oci_image",
          "xbps",
          "asar",
          "vsix-archive",
          "xpi",
          "rar",
          "7z",
          "cpio"
        ],
        "conf": 0.9,
        "id": "path-traversal-members",
        "desc": "Archive reports traversal-member paths",
        "crit": "notable",
        "if": {
          "type": "metrics",
          "field": "archive.path_traversal_count",
          "min": 1
        }
      }
    },
    {
      "canonical": "metadata/package/files/archive-member::absolute-path-member",
      "source": "metadata/package/files/archive-member/shape.yaml",
      "effective": {
        "platforms": [
          "windows",
          "linux"
        ],
        "for": [
          "zip",
          "tar",
          "jar",
          "whl",
          "python-sdist",
          "gem",
          "deb",
          "rpm",
          "npm",
          "nupkg",
          "crate",
          "conda",
          "egg",
          "pkg",
          "dmg",
          "crx",
          "chm",
          "cab",
          "iso",
          "oci_image",
          "xbps",
          "gentoo_binpkg",
          "asar",
          "vsix-archive",
          "xpi",
          "rar",
          "7z",
          "cpio",
          "apk",
          "alpine_apk",
          "ipa"
        ],
        "conf": 0.9,
        "id": "absolute-path-member",
        "desc": "Archive member uses an absolute path",
        "crit": "notable",
        "if": {
          "type": "value",
          "path": "archive.members[*].path",
          "regex": "^/"
        }
      }
    },
    {
      "canonical": "metadata/package/files/archive-member::backslash-rooted-member",
      "source": "metadata/package/files/archive-member/rooted-paths.yaml",
      "effective": {
        "for": [
          "zip",
          "tar",
          "jar",
          "whl",
          "python-sdist",
          "gem",
          "deb",
          "rpm",
          "npm",
          "nupkg",
          "crate",
          "conda",
          "egg",
          "pkg",
          "dmg",
          "crx",
          "chm",
          "cab",
          "iso",
          "oci_image",
          "xbps",
          "gentoo_binpkg",
          "asar",
          "vsix-archive",
          "xpi",
          "rar",
          "7z",
          "cpio",
          "apk",
          "alpine_apk",
          "ipa"
        ],
        "platforms": [
          "windows",
          "linux"
        ],
        "id": "backslash-rooted-member",
        "desc": "Archive member path begins with a backslash",
        "crit": "notable",
        "conf": 0.9,
        "if": {
          "type": "value",
          "path": "archive.members[*].path",
          "regex": "^\\\\"
        }
      }
    },
    {
      "canonical": "metadata/package/files/archive-member::drive-rooted-member",
      "source": "metadata/package/files/archive-member/rooted-paths.yaml",
      "effective": {
        "for": [
          "zip",
          "tar",
          "jar",
          "whl",
          "python-sdist",
          "gem",
          "deb",
          "rpm",
          "npm",
          "nupkg",
          "crate",
          "conda",
          "egg",
          "pkg",
          "dmg",
          "crx",
          "chm",
          "cab",
          "iso",
          "oci_image",
          "xbps",
          "gentoo_binpkg",
          "asar",
          "vsix-archive",
          "xpi",
          "rar",
          "7z",
          "cpio",
          "apk",
          "alpine_apk",
          "ipa"
        ],
        "platforms": [
          "windows",
          "linux"
        ],
        "id": "drive-rooted-member",
        "desc": "Archive member path has a drive root",
        "crit": "notable",
        "conf": 0.9,
        "if": {
          "type": "value",
          "path": "archive.members[*].path",
          "regex": "^[A-Za-z]:[/\\\\]"
        }
      }
    }
  ],
  "crate_before": {
    "platforms": [
      "windows",
      "unix"
    ],
    "id": "rust-crate-basename",
    "desc": "Rust crate package archive basename",
    "crit": "baseline",
    "conf": 0.95,
    "for": [
      "crate"
    ],
    "if": {
      "type": "basename",
      "regex": "(?i)\\.crate$"
    }
  },
  "crate_after": {
    "platforms": [
      "windows",
      "unix"
    ],
    "id": "rust-crate-basename",
    "desc": "Archive basename has a .crate suffix",
    "crit": "baseline",
    "conf": 0.95,
    "for": [
      "crate"
    ],
    "if": {
      "type": "basename",
      "regex": "(?i)\\.crate$"
    }
  },
  "intentional_change": {
    "before": {
      "type": "raw",
      "substr": ".."
    },
    "after": {
      "type": "value",
      "path": "archive.members[*].path",
      "regex": "(^|[/\\\\])\\.\\.([/\\\\]|$)"
    },
    "reason": "Double-dot bytes anywhere in an archive do not establish a traversal member. Suppress the contextual diagnostic only for an actual parsed parent-directory segment."
  },
  "pkg_before": {
    "platforms": [
      "unix"
    ],
    "for": [
      "pkg"
    ],
    "id": "pkg-archive-kind",
    "desc": "Package archive format marker",
    "crit": "component",
    "conf": 0.98,
    "if": {
      "type": "value",
      "path": "archive.format.kind",
      "exact": "pkg"
    }
  },
  "pkg_after": {
    "for": [
      "pkg"
    ],
    "platforms": [
      "unix",
      "windows"
    ],
    "id": "archive-format-pkg",
    "desc": "Archive parser identifies a pkg wrapper",
    "crit": "baseline",
    "conf": 0.98,
    "if": {
      "type": "value",
      "path": "archive.format.kind",
      "exact": "pkg"
    }
  },
  "intentional_changes": [
    "Raw double-dot bytes replaced by reported traversal-member count.",
    "Raw ZIP-header prefixes replaced by parsed rooted member paths.",
    "Compressed-tar suffix context is limited to tar-based carriers; crate/pkg identities require their actual file types.",
    "The existing slash-rooted member atom now covers all archive carriers; its predicate remains unchanged."
  ],
  "raw_metric": {
    "source": "metadata/file/archive/archive.yaml",
    "effective": {
      "platforms": [
        "windows",
        "linux"
      ],
      "for": [
        "zip",
        "tar",
        "jar",
        "whl",
        "python-sdist",
        "gem",
        "deb",
        "rpm",
        "npm",
        "nupkg",
        "crate",
        "pkg",
        "dmg",
        "crx",
        "chm",
        "cab",
        "iso",
        "oci_image",
        "xbps",
        "asar",
        "vsix-archive",
        "xpi",
        "rar",
        "7z",
        "cpio"
      ],
      "crit": "baseline",
      "conf": 0.9,
      "id": "archive-parser-errors-present",
      "desc": "Archive parser error count is nonzero",
      "if": {
        "type": "metrics",
        "field": "parse.error_count",
        "min": 1
      }
    }
  }
}
