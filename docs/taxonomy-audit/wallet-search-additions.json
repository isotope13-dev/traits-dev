{
  "micro-behaviors/fs/search::recursive-file-discovery": [
    "micro-behaviors/fs/search/discovery.yaml",
    "composite_rules",
    {
      "id": "recursive-file-discovery",
      "desc": "Traversal or application-bundle search evidence",
      "crit": "component",
      "conf": 0.9,
      "any": [
        {
          "id": "micro-behaviors/fs/directory/traverse/"
        },
        {
          "id": "micro-behaviors/fs/search::find-app-bundle"
        }
      ],
      "platforms": [
        "unix",
        "windows",
        "android"
      ]
    },
    {}
  ],
  "objectives/exfiltration/stealer/wallet::wallet-search-telegram-send": [
    "objectives/exfiltration/stealer/wallet/file-search-telegram.yaml",
    "composite_rules",
    {
      "platforms": [
        "windows",
        "unix"
      ],
      "for": [
        "scripts",
        "source"
      ],
      "attack": "T1567",
      "id": "wallet-search-telegram-send",
      "desc": "Wallet-search evidence with Telegram send",
      "crit": "hostile",
      "conf": 0.98,
      "near_bytes": 8192,
      "all": [
        {
          "id": "micro-behaviors/fs/search::wallet-file-search"
        }
      ],
      "any": [
        {
          "id": "micro-behaviors/communications/messaging/send::telegram-bot-send-message"
        },
        {
          "id": "micro-behaviors/communications/http/services/telegram::go-telegram-sendmessage-client"
        }
      ]
    },
    {}
  ]
}
