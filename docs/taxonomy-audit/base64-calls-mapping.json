    "old_id": "micro-behaviors/data/decode/base64::buffer-computed-base64-string-decoder",
    "new_id": "micro-behaviors/data/control-flow/dispatch::buffer-computed-method-chain",
    "before": {
      "crit": "notable",
      "platforms": [
        "unix",
        "windows"
      ],
      "for": [
        "javascript",
        "typescript"
      ],
      "id": "buffer-computed-base64-string-decoder",
      "desc": "Computed Buffer base64 string decoder",
      "conf": 0.9,
      "if": {
        "type": "text",
        "regex": "Buffer\\s*\\[[^\\]]{0,80}\\]\\s*\\([^)]{0,80},\\s*[A-Za-z_$][\\w$]*\\s*\\)\\s*\\[[^\\]]{0,80}\\]\\s*\\("
      }
    },
    "after": {
      "for": [
        "javascript",
        "typescript"
      ],
      "platforms": [
        "unix",
        "windows"
      ],
      "crit": "notable",
      "id": "buffer-computed-method-chain",
      "desc": "Computed Buffer method-call chain",
      "conf": 0.9,
      "if": {
        "type": "text",
        "regex": "Buffer\\s*\\[[^\\]]{0,80}\\]\\s*\\([^)]{0,80},\\s*[A-Za-z_$][\\w$]*\\s*\\)\\s*\\[[^\\]]{0,80}\\]\\s*\\("
      }
    },
    "action": "relocate observation",
    "reason": "Computed calls and JSON parsing do not imply Base64. Require a nested Base64 Buffer decode for the Base64-to-JSON claim; proximity to a write is described without asserting output data flow."
  },
