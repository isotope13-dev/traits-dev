[
  {
    "id": "micro-behaviors/communications/http/services/github::github-contents-client-put",
    "before": null,
    "after": {
      "file": "micro-behaviors/communications/http/services/github/contents-write.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "unix",
          "windows"
        ],
        "for": [
          "javascript",
          "typescript",
          "python"
        ],
        "crit": "notable",
        "conf": 0.94,
        "id": "github-contents-client-put",
        "desc": "Client PUT to GitHub file contents",
        "if": {
          "type": "symbol",
          "kind": "call",
          "regex": "^(requests|httpx|axios)\\.put$",
          "arg": {
            "index": 0,
            "kind": "string",
            "regex": "^https?://api\\.github\\.com/repos/[^/?#]+/[^/?#]+/contents/[^?#]+"
          }
        }
      }
    },
    "reason": "Require write-specific evidence; bind the literal contents destination to the PUT call."
  },
  {
    "id": "micro-behaviors/communications/http/services/github::github-create-repo-and-contents-write",
    "before": {
      "file": "micro-behaviors/communications/http/services/github/api.yaml",
      "kind": "composite_rules",
      "effective": {
        "platforms": [
          "unix",
          "windows"
        ],
        "for": [
          "shell",
          "python",
          "javascript",
          "typescript",
          "github-actions"
        ],
        "crit": "notable",
        "id": "github-create-repo-and-contents-write",
        "desc": "Creates a GitHub repo and writes contents",
        "conf": 0.95,
        "all": [
          {
            "id": "github-create-repo"
          }
        ],
        "any": [
          {
            "id": "github-contents-api-endpoint"
          },
          {
            "id": "github-create-or-update-file-contents"
          }
        ]
      }
    },
    "after": {
      "file": "micro-behaviors/communications/http/services/github/api.yaml",
      "kind": "composite_rules",
      "effective": {
        "platforms": [
          "unix",
          "windows"
        ],
        "for": [
          "shell",
          "python",
          "javascript",
          "typescript",
          "github-actions"
        ],
        "crit": "notable",
        "id": "github-create-repo-and-contents-write",
        "desc": "GitHub creation and contents-write APIs",
        "conf": 0.95,
        "all": [
          {
            "id": "github-create-repo"
          }
        ],
        "any": [
          {
            "id": "github-contents-client-put"
          },
          {
            "id": "github-contents-write-endpoint"
          },
          {
            "id": "github-create-or-update-file-contents"
          }
        ]
      }
    },
    "reason": "Require write-specific evidence; bind the literal contents destination to the PUT call."
  }
