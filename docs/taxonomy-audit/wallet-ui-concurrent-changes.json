    "id": "objectives/credential-access/dump/system::windows-system32-config-path",
    "action": "changed",
    "before": [
      "objectives/credential-access/dump/system/sevenzip-ntds.yaml",
      "traits",
      {
        "id": "windows-system32-config-path",
        "desc": "References System32 config hive path",
        "crit": "notable",
        "conf": 0.9,
        "if": {
          "type": "text",
          "regex": "(?i)\\\\Windows\\\\System32\\\\config\\b"
        }
      },
      {
        "platforms": [
          "windows"
        ],
        "for": [
          "powershell",
          "batch",
          "scripts"
        ],
        "attack": "T1003.003,T1560.001",
        "mbc": "B0005"
      }
    ],
    "after": [
      "objectives/credential-access/dump/system/sevenzip-ntds.yaml",
