{
  "objectives/credential-access/wallet/desktop::desktop-wallet-spoofer": {
    "definition": [
      "objectives/credential-access/wallet/desktop/spoofing.yaml",
      "composite_rules",
      {
        "id": "desktop-wallet-spoofer",
        "desc": "Desktop wallet recovery spoofer",
        "crit": "hostile",
        "conf": 0.99,
        "all": [
          {
            "id": "micro-behaviors/process/argument/option::daemon-ui-option-pair"
          },
          {
            "id": "wallet-recovery-secret-prompt"
          }
        ]
      },
      {
        "platforms": [
          "windows",
          "unix"
        ],
        "for": [
          "scripts",
          "binaries"
        ],
        "attack": "T1056.002,T1555"
      }
    ],
    "reason": "Daemon/UI options plus an ordinary wallet recovery prompt do not distinguish spoofing. Keep the UI and argument observations; remove the unsupported hostile wrapper."
  },
  "objectives/credential-access/wallet/desktop::electron-fake-wallet-persistence": {
    "definition": [
      "objectives/credential-access/wallet/desktop/electron-fake-wallet.yaml",
      "composite_rules",
      {
        "id": "electron-fake-wallet-persistence",
        "desc": "Fake wallet LaunchAgent with seed exfil",
        "crit": "hostile",
        "conf": 0.97,
        "attack": "T1543.001,T1555,T1567",
        "all": [
          {
            "id": "fake-wallet-launchagent-label"
          },
          {
            "id": "micro-behaviors/ui/dialog/prompt::secret-phrase-label"
          }
        ],
        "any": [
          {
            "id": "objectives/persistence/system/supervised::node-launchd-runatload-plist"
          },
          {
            "id": "micro-behaviors/os/service/launchagent::launchagents-path"
          }
        ],
        "needs": 1
      },
      {
        "platforms": [
          "windows",
          "unix"
        ],
        "for": [
          "javascript",
          "typescript",
          "shell",
          "scripts",
          "asar",
          "dmg",
          "pkg",
          "zip"
        ],
        "attack": "T1185,T1567,T1555"
      }
    ],
    "reason": "Wallet-associated label, secret UI and RunAtLoad/path vocabulary do not distinguish malicious persistence or exfiltration. Preserve the underlying observations and actual secret-export classifiers."
  }
}
