[
  {
    "old_id": "metadata/package/documentation::npm-ctf-description",
    "new_id": "metadata/package/description/disclosure::npm-ctf-description",
    "before": {
      "platforms": [
        "linux",
        "macos",
        "windows",
        "unix",
        "android",
        "ios"
      ],
      "for": [
        "package.json"
      ],
      "id": "npm-ctf-description",
      "desc": "Package description references CTF",
      "crit": "suspicious",
      "conf": 0.95,
      "attack": "T1195.002",
      "if": {
        "type": "value",
        "path": "description",
        "regex": "(?i)ctf"
      }
    },
    "after": {
      "platforms": [
        "unix",
        "windows",
        "android",
        "ios"
      ],
      "for": [
        "package.json"
      ],
      "id": "npm-ctf-description",
      "desc": "Package description references CTF",
      "crit": "notable",
      "conf": 0.95,
      "if": {
        "type": "value",
        "path": "description",
        "regex": "(?i)\\bctf\\b"
      }
    }
  },
