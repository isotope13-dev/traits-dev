{
  "rules": [
    {
      "old_id": "objectives/command-and-control/dropper/staging/encrypted::dotnet-hex-xor-payload-loader",
      "new_id": "objectives/command-and-control/dropper/module-load::dotnet-hex-xor-payload-loader",
      "activation_sink": "Runtime assembly loading",
      "preserved": [
        "metadata/binary/framework::dotnet-assembly",
        "micro-behaviors/crypto/symmetric/xor/term::dotnet-xor-key-context",
        "objectives/anti-static/obfuscation/reflection/class::dotnet-assembly-load",
        "well-known/app/media/subtitleedit/"
      ],
      "removed": "A component that matched any of Assembly.Load, EntryPoint.Invoke, Path.GetTempPath, or Process.Start. These alternatives did not define one activation mechanism; the separate Process.Start consumer already required that operation."
    },
    {
      "old_id": "objectives/command-and-control/dropper/staging/encrypted::dotnet-hex-chunk-reassembly",
      "new_id": "micro-behaviors/data/decode/hex::dotnet-stringbuilder-hex-decoding-references",
      "matcher": "The existing StringBuilder append plus .NET hex-conversion references are unchanged.",
      "scope": "Windows; pe, dll, csharp",
      "consumers": [
        "objectives/command-and-control/dropper/module-load::dotnet-hex-xor-payload-loader",
        "objectives/evasion/process/hook/jit/dotnet.yaml (two refs)",
        "objectives/command-and-control/dropper/execution/loader/dotnet-loader.yaml"
      ]
    }
  ]
}
