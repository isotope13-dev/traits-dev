[
  {
    "id": "metadata/package/documentation/source::documentation-dir-path",
    "before": [
      "metadata/package/documentation/source/traits.yaml",
      "traits",
      {
        "id": "documentation-dir-path",
        "desc": "File under documentation directory",
        "crit": "baseline",
        "conf": 0.9,
        "for": [
          "markdown",
          "javascript",
          "text",
          "python",
          "shell",
          "applescript"
        ],
        "if": {
          "type": "path",
          "dirname": true,
          "regex": "(^|[\\\\/])(docs?|documentation|manuals?)([\\\\/]|$)",
          "case_insensitive": true
        }
      },
      {
        "platforms": [
          "windows",
          "unix"
        ],
        "for": [
          "source"
        ]
      }
    ],
