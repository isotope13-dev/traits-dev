  {
    "id": "objectives/credential-access/pam/intercept::sshd-credential-log-path",
    "before": [
      "objectives/credential-access/pam/intercept/traits.yaml",
      "traits",
      {
        "id": "sshd-credential-log-path",
        "desc": "Hidden sshd credential log path",
        "crit": "notable",
        "conf": 0.92,
        "for": [
          "elf",
          "so",
          "c",
          "cpp",
          "shell",
          "scripts"
        ],
        "if": {
          "type": "text",
          "regex": "/(tmp|var/log)/\\.sshd([-_][A-Za-z0-9_-]{0,24}|\\.log)?\\b"
        }
      },
      {
        "platforms": [
          "unix"
        ],
        "attack": "T1556.003",
        "for": [
          "elf"
        ]
      }
    ],
    "after": [
      "objectives/credential-access/pam/intercept/traits.yaml",
      "traits",
      {
        "id": "sshd-credential-log-path",
        "desc": "Hidden sshd credential log path",
        "crit": "notable",
        "conf": 0.92,
        "for": [
          "elf",
          "so",
          "c",
          "cpp",
          "shell",
          "scripts"
        ],
        "if": {
          "type": "text",
          "regex": "/(tmp|var/log)/\\.sshd(?:[-_](?:auth|cred(?:ential)?|log|pass(?:word)?)|\\.(?:auth|cred(?:ential)?|log|pass(?:word)?))[A-Za-z0-9_-]{0,16}\\b"
        }
      },
      {
        "platforms": [
          "unix"
        ],
        "attack": "T1556.003",
        "for": [
          "elf"
        ]
      }
    ]
  },
