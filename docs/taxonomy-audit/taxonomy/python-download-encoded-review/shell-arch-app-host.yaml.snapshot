# A shell stager that asks which CPU it is on, fetches the matching build of
# an executable from a site still wearing its hosting platform's generated
# name, and marks it executable. Release installers fingerprint the CPU too,
# but they pull from the vendor's own domain or a release host; an origin
# nobody bothered to name is disposable infrastructure, and a per-arch binary
# from it is a payload drop whatever the script does with it next.
defaults:
  platforms: [linux, macos]
  for: [shell]
  attack: T1105,T1082
  mbc: B0024

composite_rules:
  - id: shell-cpu-arch-fingerprint
    desc: Shell reads the CPU architecture
    crit: component
    conf: 0.9
    any:
      - id: micro-behaviors/os/sysinfo/platform/arch::sh-arch-query
      - id: micro-behaviors/os/sysinfo/platform/arch::sh-arch-command-query
      - id: micro-behaviors/os/sysinfo/platform/arch::sh-arch-tool-query
      - id: micro-behaviors/os/sysinfo/platform/arch::sh-hosttype-variable
      - id: micro-behaviors/os/sysinfo/platform/arch::arch-aware-curl-download
      - id: objectives/discovery/system/architecture::arch-variable-in-artifact-name

  # Hostnames the platform chose, not the owner.
  - id: generated-app-host
    desc: Hosting platform generated hostname
    crit: component
    conf: 0.9
    any:
      - id: micro-behaviors/communications/http/services/cloud::netlify-generated-site-host
      - id: micro-behaviors/communications/http/services/file-hosting::heroku-generated-app-host
      - id: micro-behaviors/communications/proxy/tunnel::trycloudflare-quick-tunnel-host

  - id: shell-fetch-to-file
    desc: Shell downloads to a named file
    crit: component
    conf: 0.9
    any:
      - id: micro-behaviors/communications/http/download/curl::curl-output-file
      - id: micro-behaviors/communications/http/download/wget::wget-output-file
      - id: micro-behaviors/communications/http/download/cli::aria2c-output-file

  - id: shell-arch-binary-from-generated-host
    desc: Per-arch binary from an auto-named app host
    crit: hostile
    conf: 0.93
    all:
      - id: shell-cpu-arch-fingerprint
      - id: generated-app-host
      - id: shell-fetch-to-file
      - id: micro-behaviors/fs/chmod/executable/mode::shell-mark-executable
