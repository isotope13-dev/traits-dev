    {
      "old": "objectives/anti-analysis/sandbox-detect/script::python-sandbox-score-exit",
      "new": "objectives/anti-analysis/sandbox-detect/score::python-sandbox-score-exit",
      "source": "objectives/anti-analysis/sandbox-detect/script/python-score-gate.yaml",
      "destination": "objectives/anti-analysis/sandbox-detect/score/python-score-gate.yaml",
      "kind": "traits",
      "rule": {
        "id": "python-sandbox-score-exit",
        "desc": "Sandbox probe result gates Python exit",
        "crit": "suspicious",
        "conf": 0.92,
        "if": {
          "type": "tree-sitter",
          "query": "((_\n  (expression_statement (assignment\n    left: (identifier) @score\n    right: (call function: (identifier) @probe)))\n  . (if_statement\n    condition: (comparison_operator (identifier) @tested (float))\n    consequence: (block (expression_statement\n      (call function: (identifier) @exit)))) @evidence)\n  (#eq? @score @tested) (#eq? @probe \"is_sandboxed\")\n  (#eq? @exit \"exit\"))\n((_\n  (try_statement body: (block .\n    (expression_statement (assignment\n      left: (identifier) @score\n      right: (call function: (identifier) @probe))) .)\n    (except_clause (block . (expression_statement (assignment\n      left: (identifier) @fallback\n      right: [(integer) (float)])) .)) .)\n  . (if_statement\n    condition: (comparison_operator (identifier) @tested (float))\n    consequence: (block (expression_statement\n      (call function: (identifier) @exit)))) @evidence)\n  (#eq? @score @tested) (#eq? @probe \"is_sandboxed\")\n  (#eq? @score @fallback) (#eq? @exit \"exit\"))\n"
        }
      },
      "defaults": {
        "platforms": [
          "windows",
          "unix"
        ],
        "for": [
          "python"
        ]
      }
