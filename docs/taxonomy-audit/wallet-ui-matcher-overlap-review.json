{
  "same_reference_body": true,
  "merged": false,
  "reason": "Count minimum 4 versus 2, effective file/platform scope, confidence, size limit and exclusions differ. A matching reference body is insufficient for merging these observations.",
  "rules": [
    {
      "id": "micro-behaviors/os/application/target::crypto-wallet-keyword-cluster--rx-2",
      "before": [
        "objectives/credential-access/wallet/keywords/keyword-cluster.yaml",
        "traits",
        {
          "id": "crypto-wallet-keyword-cluster--rx-2",
          "desc": "Repeated Phantom wallet keyword",
          "crit": "component",
          "conf": 0.9,
          "count_min": 4,
          "if": {
            "id": "well-known/lib/crypto/web3::phantom-wallet-word"
          },
          "unless": [
            {
              "type": "trait",
              "id": "metadata/file/extension/identity::linux-kernel-package-artifact-basename"
            }
          ]
        },
        {
          "platforms": [
            "windows",
            "unix"
          ],
          "for": [
            "scripts",
            "binaries"
          ],
          "crit": "notable",
          "conf": 0.8,
          "attack": "T1552.001"
        }
      ],
      "effective_settings": {
        "platforms": [
          "windows",
          "unix"
        ],
        "for": [
          "scripts",
          "binaries"
        ],
        "crit": "component",
        "conf": 0.9,
        "attack": "T1552.001",
        "count_min": 4,
        "unless": [
          {
            "type": "trait",
            "id": "metadata/file/extension/identity::linux-kernel-package-artifact-basename"
          }
        ]
      }
    },
    {
      "id": "objectives/credential-access/wallet/mnemonic::phantom-word",
      "before": [
        "objectives/credential-access/wallet/mnemonic/traits.yaml",
        "traits",
        {
          "id": "phantom-word",
          "desc": "Phantom wallet reference",
          "crit": "component",
          "conf": 0.5,
          "for": [
            "python",
            "javascript",
            "csharp",
            "go"
          ],
          "size_max": 10485760,
          "count_min": 2,
          "if": {
            "id": "well-known/lib/crypto/web3::phantom-wallet-word"
          },
          "unless": [
            {
              "type": "text",
              "substr": "paperSize"
            },
            {
              "id": "objectives/anti-analysis/sandbox-detect/tool-references/"
            }
          ]
        },
        {
          "platforms": [
            "windows",
            "linux",
            "macos"
          ],
          "for": [
            "python",
            "javascript",
            "csharp",
            "go",
            "pe",
            "elf"
          ],
          "attack": "T1555",
          "mbc": "B0028",
          "crit": "suspicious"
        }
      ],
      "effective_settings": {
        "platforms": [
          "windows",
          "linux",
          "macos"
        ],
        "for": [
          "python",
          "javascript",
          "csharp",
          "go"
        ],
        "attack": "T1555",
        "mbc": "B0028",
        "crit": "component",
        "conf": 0.5,
        "size_max": 10485760,
        "count_min": 2,
        "unless": [
          {
            "type": "text",
            "substr": "paperSize"
          },
          {
            "id": "objectives/anti-analysis/sandbox-detect/tool-references/"
          }
        ]
      }
    }
  ]
}
