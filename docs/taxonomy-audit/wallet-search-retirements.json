{
  "objectives/credential-access/wallet/desktop::crypto-wallet-file-stealer": {
    "definition": [
      "objectives/credential-access/wallet/desktop/wallet-file-search.yaml",
      "composite_rules",
      {
        "id": "crypto-wallet-file-stealer",
        "for": [
          "javascript"
        ],
        "desc": "Crypto wallet file stealer",
        "crit": "hostile",
        "conf": 0.96,
        "unless": [
          {
            "id": "well-known/lib/format/json-ts"
          },
          {
            "id": "well-known/tool/detection/security-scanner/"
          },
          {
            "id": "well-known/tool/detection/threat-intel/"
          },
          {
            "id": "well-known/lib/ai/coding-assistant::cline-extension-api-host"
          }
        ],
        "all": [
          {
            "id": "crypto-json-filename-filter"
          }
        ]
      },
      {
        "platforms": [
          "windows",
          "unix"
        ],
        "for": [
          "scripts",
          "binaries"
        ],
        "crit": "notable",
        "conf": 0.8,
        "attack": "T1552.001"
      }
    ],
    "reason": "Hostile wrapper adds no acquisition evidence to its sole JSON filename-filter leg; preserve the underlying suspicious filter and its consumers."
  }
}
