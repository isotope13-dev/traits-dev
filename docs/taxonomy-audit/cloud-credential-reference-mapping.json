{
  "audit": "cloud-credential-references",
  "principle": "Static cloud endpoint, environment-name, and credential/config-path strings are probable capability evidence, not file metadata or proof of access.",
  "moves": [
    {
      "from": "objectives/credential-access/cloud/token/metadata::cloud-metadata-path-set",
      "to": "micro-behaviors/communications/http/services/aws::iam-credentials-path-reference",
      "decision": "Reuse the existing canonical AWS credential-path reference."
    },
    {
      "from": "objectives/credential-access/cloud/token/metadata::cloud-env-secret-set",
      "to": "micro-behaviors/os/env/cloud::cloud-secret-environment-name-set",
      "matcher": "AWS_SECRET_ACCESS_KEY followed within 360 bytes by AZURE_CLIENT_SECRET"
    },
    {
      "from": "objectives/credential-access/cloud/token/metadata::cloud-config-path-set",
      "to": "micro-behaviors/fs/path/credential::cloud-config-path-set",
      "matcher": ".kube/config followed within 360 bytes by .docker/config.json"
    },
    {
      "from": "objectives/credential-access/cloud/token/metadata::rust-cloud-metadata-endpoint-set",
      "to": "micro-behaviors/os/security/auth/cloud::rust-cloud-metadata-endpoint-reference",
      "scope": "Rust source only; ELF objective composites independently require Rust compiler evidence."
    },
    {
      "from": "metadata/file/string/cloud::gcp-service-account-token-path",
      "to": "micro-behaviors/communications/http/services/gcp::gcp-service-account-token-path",
      "matcher": "/computeMetadata/v1/instance/service-accounts/default/token"
    },
    {
      "from": "metadata/file/string/cloud::gcp-service-accounts-metadata-path",
      "to": "micro-behaviors/communications/http/services/gcp::gcp-service-accounts-metadata-path",
      "matcher": "/computeMetadata/v1/instance/service-accounts"
    },
    {
      "from": "metadata/file/string/cloud::gcp-default-service-account-email-path",
      "to": "micro-behaviors/communications/http/services/gcp::gcp-default-service-account-email-path",
      "matcher": "/computeMetadata/v1/instance/service-accounts/default/email"
    },
    {
      "from": "metadata/file/string/cloud::aws-imds-v2-token-endpoint",
      "to": "micro-behaviors/communications/http/services/aws::aws-imds-v2-token-endpoint",
      "decision": "169.254.169.254/latest/api/token"
    },
    {
      "from": "metadata/file/string/cloud::aws-user-data-endpoint",
      "to": "micro-behaviors/communications/http/services/aws::aws-user-data-endpoint",
      "decision": "AWS user-data endpoint regex retained"
    },
    {
      "from": "metadata/file/string/cloud::aws-imds-v2-token-path",
      "to": "micro-behaviors/communications/http/services/aws::aws-imds-v2-token-path",
      "decision": "/latest/api/token"
    },
    {
      "from": "metadata/file/string/cloud::aws-instance-id-metadata-path",
      "to": "micro-behaviors/communications/http/services/aws::aws-instance-id-metadata-path",
      "decision": "/latest/meta-data/instance-id; benign cloud-agent suppression retained"
    },
    {
      "from": "metadata/file/string/cloud::aws-metadata-endpoint",
      "to": "micro-behaviors/communications/http/services/aws::aws-metadata-endpoint",
      "decision": "AWS endpoint and corpus suppressions retained"
    },
    {
      "from": "metadata/file/string/cloud::aws-instance-metadata-relative-path",
      "to": "micro-behaviors/communications/http/services/aws::aws-instance-metadata-relative-path",
      "decision": "instance-data/latest/meta-data"
    },
    {
      "from": "metadata/file/string/cloud::aws-ecs-credentials-base-path",
      "to": "micro-behaviors/communications/http/services/aws::aws-ecs-credentials-base-path",
      "decision": "ECS base endpoint regex retained"
    },
    {
      "from": "metadata/file/string/cloud::aws-ecs-task-credentials-endpoint",
      "to": "micro-behaviors/communications/http/services/aws::aws-ecs-task-credentials-endpoint",
      "decision": "ECS credential-ID endpoint regex retained"
    },
    {
      "from": "metadata/file/string/cloud::aws-ecs-iam-metadata-path",
      "to": "micro-behaviors/communications/http/services/aws::aws-ecs-iam-metadata-path",
      "decision": "ECS host and IAM path regex retained"
    },
    {
      "from": "metadata/file/string/cloud::azure-metadata-endpoint",
      "to": "micro-behaviors/communications/http/services/azure::azure-metadata-endpoint",
      "decision": "Azure endpoint and managed-identity suppressions retained"
    },
    {
      "from": "metadata/file/string/cloud::azure-imds-instance-path",
      "to": "micro-behaviors/communications/http/services/azure::azure-imds-instance-path",
      "decision": "Azure instance path and managed-identity suppressions retained"
    },
    {
      "from": "metadata/file/string/cloud::azure-managed-identity-token-path",
      "to": "micro-behaviors/communications/http/services/azure::azure-managed-identity-token-path",
      "decision": "OAuth token path and managed-identity suppressions retained"
    },
    {
      "from": "metadata/file/string/cloud::cloud-instance-metadata-link-local-host",
      "to": "micro-behaviors/communications/http/services/cloud::cloud-instance-metadata-link-local-host",
      "decision": "Shared provider-neutral link-local host clue"
    },
    {
      "from": "metadata/file/string/cloud::aws-metadata-token-header",
      "to": "micro-behaviors/communications/http/header/custom::aws-imds-token-header",
      "decision": "AWS token header; ID renamed to align the IMDS subject"
    },
    {
      "from": "metadata/file/string/cloud::aws-imds-v2-token-ttl-header",
      "to": "micro-behaviors/communications/http/header/custom::aws-imds-token-ttl-header",
      "decision": "AWS token TTL header"
    },
    {
      "from": "metadata/file/string/cloud::gcp-metadata-endpoint-go-source",
      "to": "micro-behaviors/communications/http/services/gcp::gcp-metadata-endpoint-go-source",
      "decision": "GCP metadata host in Go source"
    },
    {
      "from": "metadata/file/string/cloud::gcp-default-credentials",
      "to": "micro-behaviors/fs/path/credential::gcp-default-credentials",
      "decision": "application_default_credentials.json"
    },
    {
      "from": "micro-behaviors/communications/http/services/cloud::gcp-metadata-endpoint-reference",
      "to": "micro-behaviors/communications/http/services/gcp::gcp-metadata-endpoint-reference",
      "decision": "GCP metadata DNS host clue"
    },
    {
      "from": "micro-behaviors/communications/http/services/cloud::gcp-metadata-endpoint",
      "to": "micro-behaviors/communications/http/services/gcp::gcp-metadata-endpoint",
      "decision": "Native binary GCP host clue"
    },
    {
      "from": "micro-behaviors/communications/http/services/cloud::gcp-metadata-client-import",
      "to": "micro-behaviors/communications/http/services/gcp::gcp-metadata-client-import",
      "decision": "GCP metadata SDK import clue"
    },
    {
      "from": "micro-behaviors/communications/http/services/cloud::gcp-metadata-client-query-call",
      "to": "micro-behaviors/communications/http/services/gcp::gcp-metadata-client-query-call",
      "decision": "GCP metadata SDK query-call clue"
    },
    {
      "from": "micro-behaviors/communications/http/services/cloud::gcp-metadata-flavor-header",
      "to": "micro-behaviors/communications/http/header/custom::gcp-metadata-flavor-header",
      "decision": "GCP metadata request header"
    },
    {
      "from": "micro-behaviors/communications/http/services/cloud::alibaba-metadata-endpoint-reference",
      "to": "micro-behaviors/communications/http/services/alibaba::alibaba-metadata-endpoint-reference",
      "decision": "Alibaba provider endpoint clue"
    },
    {
      "from": "micro-behaviors/communications/http/services/cloud::tencent-metadata-host-endpoint-reference",
      "to": "micro-behaviors/communications/http/services/tencent::tencent-metadata-host-endpoint-reference",
      "decision": "Tencent metadata hostname clue"
    },
    {
      "from": "micro-behaviors/communications/http/services/cloud::tencent-metadata-ip-endpoint-reference",
      "to": "micro-behaviors/communications/http/services/tencent::tencent-metadata-ip-endpoint-reference",
      "decision": "Tencent metadata IP endpoint clue"
    }
  ],
  "consumer_audit": {
    "objective": "objectives/credential-access/cloud/token/metadata/rust-unix.yaml",
    "other_files": [
      "objectives/credential-access/cloud/token/metadata/multi-provider-sweep.yaml",
      "objectives/discovery/cloud/metadata/traits.yaml",
      "micro-behaviors/os/security/auth/cloud/metadata.yaml"
    ],
    "all_old_gcp_references_remapped": true,
    "all_relocated_cloud_metadata_consumers_remapped": true,
    "retired_source_directory": "metadata/file/string/cloud",
    "validated_rule_ids": "AWS, Azure, GCP, Alibaba, Tencent, generic cloud host, custom headers, and GCP credential path"
  },
  "checks": {
    "benign_rust_endpoint_without_secret_cluster": "capability retained; hostile composite does not match",
    "synthetic_rust_endpoint_with_secret_name_cluster": "hostile composite matches",
    "benign_mongodb_provider_elf": "neutral capability markers may match; Rust hostile composites require compiler evidence",
    "synthetic_relocated_endpoint_tests": "AWS, Azure, Alibaba, Tencent, generic cloud host, GCP SDK import, and GCP header matched; no broken references remain from these moves"
  }
}
