{
  "audit": "cloud-credential-references",
  "principle": "Static cloud endpoint, environment-name, and credential/config-path strings are probable capability evidence, not file metadata or proof of access.",
  "moves": [
    {
      "from": "objectives/credential-access/cloud/token/metadata::cloud-metadata-path-set",
      "to": "micro-behaviors/communications/http/services/aws::iam-credentials-path-reference",
      "decision": "Reuse the existing canonical AWS credential-path reference."
    },
    {
      "from": "objectives/credential-access/cloud/token/metadata::cloud-env-secret-set",
      "to": "micro-behaviors/os/env/cloud::cloud-secret-environment-name-set",
      "matcher": "AWS_SECRET_ACCESS_KEY followed within 360 bytes by AZURE_CLIENT_SECRET"
    },
    {
      "from": "objectives/credential-access/cloud/token/metadata::cloud-config-path-set",
      "to": "micro-behaviors/fs/path/credential::cloud-config-path-set",
      "matcher": ".kube/config followed within 360 bytes by .docker/config.json"
    },
    {
      "from": "objectives/credential-access/cloud/token/metadata::rust-cloud-metadata-endpoint-set",
      "to": "micro-behaviors/os/security/auth/cloud::rust-cloud-metadata-endpoint-reference",
      "scope": "Rust source only; ELF objective composites independently require Rust compiler evidence."
    },
    {
      "from": "metadata/file/string/cloud::gcp-service-account-token-path",
      "to": "micro-behaviors/communications/http/services/gcp::gcp-service-account-token-path",
      "matcher": "/computeMetadata/v1/instance/service-accounts/default/token"
    },
    {
      "from": "metadata/file/string/cloud::gcp-service-accounts-metadata-path",
      "to": "micro-behaviors/communications/http/services/gcp::gcp-service-accounts-metadata-path",
      "matcher": "/computeMetadata/v1/instance/service-accounts"
    },
    {
      "from": "metadata/file/string/cloud::gcp-default-service-account-email-path",
      "to": "micro-behaviors/communications/http/services/gcp::gcp-default-service-account-email-path",
      "matcher": "/computeMetadata/v1/instance/service-accounts/default/email"
    }
  ],
  "consumer_audit": {
    "objective": "objectives/credential-access/cloud/token/metadata/rust-unix.yaml",
    "other_files": [
      "objectives/credential-access/cloud/token/metadata/multi-provider-sweep.yaml",
      "objectives/discovery/cloud/metadata/traits.yaml",
      "micro-behaviors/os/security/auth/cloud/metadata.yaml"
    ],
    "all_old_gcp_references_remapped": true
  },
  "checks": {
    "benign_rust_endpoint_without_secret_cluster": "capability retained; hostile composite does not match",
    "synthetic_rust_endpoint_with_secret_name_cluster": "hostile composite matches",
    "benign_mongodb_provider_elf": "neutral capability markers may match; Rust hostile composites require compiler evidence"
  }
}
