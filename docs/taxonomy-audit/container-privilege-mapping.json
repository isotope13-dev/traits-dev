  {
    "old": "micro-behaviors/os/container/runtime::docker-privileged-flag",
    "new": "metadata/file/string/security::privileged-option-text",
    "reason": "Generic privilege text does not identify Docker, Kubernetes or SDK use.",
    "before": {
      "file": "micro-behaviors/os/container/runtime/docker.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "windows",
          "unix"
        ],
        "for": [
          "scripts",
          "binaries",
          "go"
        ],
        "id": "docker-privileged-flag",
        "desc": "Docker privileged CLI flag",
        "crit": "notable",
        "conf": 0.8,
        "if": {
          "type": "text",
          "word": "--privileged"
        }
      }
    },
    "after": {
      "file": "metadata/file/string/security/privilege-settings.yaml",
      "kind": "traits",
      "effective": {
        "platforms": [
          "windows",
          "unix"
        ],
        "for": [
          "scripts",
          "binaries",
          "go"
        ],
        "id": "privileged-option-text",
        "desc": "Enabled privileged option text",
        "crit": "notable",
        "conf": 0.8,
        "if": {
          "type": "text",
          "regex": "(^|[^A-Za-z0-9_-])--privileged(=true)?($|[\\s\"'`,;)\\]}])"
        }
      }
    },
    "matcher_change": "Replace nonword-leading word shorthand with enabled-option boundaries; reject false and longer option names."
  },
