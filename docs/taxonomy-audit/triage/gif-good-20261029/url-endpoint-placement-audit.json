[
  {
    "id": "micro-behaviors/communications/http/url/endpoint::rest-file-tree-endpoints",
    "destination": "micro-behaviors/communications/http/url/endpoint",
    "description": "REST file tree endpoints",
    "matcher": {
      "type": "text",
      "regex": "(?i)\\b(get|post|put|patch|delete|route)\\s*\\(\\s*[\"']/(public/)?(tree|files|metadata)\\b"
    },
    "review_passes": 2
  },
