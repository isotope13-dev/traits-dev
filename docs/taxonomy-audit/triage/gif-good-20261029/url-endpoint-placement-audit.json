  {
    "id": "micro-behaviors/communications/http/url/endpoint::javascript-request-explicit-destination",
    "destination": "micro-behaviors/communications/http/url/endpoint",
    "description": "Node request has an explicit destination",
    "matcher": {
      "type": "tree-sitter",
      "query": "((call_expression\n  function: (member_expression object: (identifier) @http property: (property_identifier) @request)\n  arguments: (arguments (object (pair key: (property_identifier) @hostname value: (string) @target)))) @send\n  (#match? @http \"^https?$\")\n  (#eq? @request \"request\")\n  (#eq? @hostname \"hostname\"))\n((call_expression\n  function: (member_expression object: (identifier) @http property: (property_identifier) @request)\n  arguments: (arguments [(string) (template_string)] @target)) @send\n  (#match? @http \"^https?$\")\n  (#eq? @request \"request\")\n  (#match? @target \"https?://\"))\n"
    },
    "review_passes": 2
  },
