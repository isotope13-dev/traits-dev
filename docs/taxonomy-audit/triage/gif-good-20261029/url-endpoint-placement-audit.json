    "id": "micro-behaviors/communications/http/url/endpoint::rest-file-mutation-endpoints--single",
    "destination": "micro-behaviors/communications/http/url/endpoint",
    "description": "REST single-file mutation endpoint",
    "matcher": {
      "type": "text",
      "regex": "/(files|tree)/(rename|move|copy)"
    },
    "review_passes": 2
  },
  {
    "id": "micro-behaviors/communications/http/url/endpoint::rest-file-mutation-endpoints--bulk",
