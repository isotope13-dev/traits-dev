+fn children(n: Node<'_>) -> Vec<Node<'_>> {
+    let mut cursor = n.walk();
+    n.named_children(&mut cursor)
+        .filter(|n| !matches!(n.kind(), "comment" | "empty_statement"))
+        .collect()
