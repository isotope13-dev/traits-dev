+fn literal(node: Node<'_>, source: &str) -> Option<String> {
+    if node.kind() != "string" {
+        return None;
+    }
+    let s = raw(node, source)?;
+    Some(filefacts::decode_source_escapes_for_type(
+        s.get(1..s.len().checked_sub(1)?)?,
+        filefacts::FileType::JavaScript,
+    ))
