  {
    "old_id": "metadata/binary/symbols/compiler::cxx-mangled-symbol-prefix",
    "new_id": "metadata/binary/symbols/compiler::cxx-mangled-symbol-prefix",
    "before_kind": "traits",
    "after_kind": "traits",
    "before": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "for": [
        "elf",
        "macho",
        "pe"
      ],
      "id": "cxx-mangled-symbol-prefix",
      "desc": "C++-style mangled symbol prefix",
      "crit": "baseline",
      "conf": 0.8,
      "if": {
        "type": "symbol",
        "regex": "^(_ZN[A-Z]|_ZSt|_ZNSt|_ZNK[A-Z])"
      }
    },
    "after": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "for": [
        "elf",
        "macho",
        "pe"
      ],
      "id": "cxx-mangled-symbol-prefix",
      "desc": "C++-style mangled symbol prefix",
      "crit": "baseline",
      "conf": 0.8,
      "if": {
        "type": "symbol",
        "regex": "^_{0,2}(ZN[A-Z]|ZSt|ZNSt|ZNK[A-Z])"
      }
    }
  },
  {
