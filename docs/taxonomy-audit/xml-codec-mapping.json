      "if": {
        "type": "tree-sitter",
        "language": "javascript",
        "query": "(\n (statement_block\n  [\n  (variable_declaration (variable_declarator name: (identifier) @doc value: (new_expression constructor: (identifier) @ctor arguments: (arguments (string (string_fragment) @progid)))))\n  (lexical_declaration (variable_declarator name: (identifier) @doc value: (new_expression constructor: (identifier) @ctor arguments: (arguments (string (string_fragment) @progid)))))\n]\n  . [\n  (variable_declaration (variable_declarator name: (identifier) @node value: (call_expression function: (member_expression object: (identifier) @doc_use property: (property_identifier) @create) arguments: (arguments (string)))))\n  (lexical_declaration (variable_declarator name: (identifier) @node value: (call_expression function: (member_expression object: (identifier) @doc_use property: (property_identifier) @create) arguments: (arguments (string)))))\n]\n  . (expression_statement (assignment_expression\n      left: (member_expression object: (identifier) @node_type property: (property_identifier) @type_property)\n      right: (string (string_fragment) @base64)))\n  . (expression_statement (assignment_expression\n      left: (member_expression object: (identifier) @node_input property: (property_identifier) @input_property)\n      right: (identifier) @input))\n  . (return_statement (member_expression\n      object: (identifier) @node_output property: (property_identifier) @output_property))\n ) @codec\n (#eq? @ctor \"ActiveXObject\")\n (#match? @progid \"(?i)^msxml2\\\\.domdocument(\\\\.[0-9]+\\\\.[0-9]+)?$\")\n (#eq? @doc @doc_use)\n (#eq? @create \"createElement\")\n (#eq? @node @node_type)\n (#eq? @node @node_input)\n (#eq? @node @node_output)\n (#eq? @type_property \"dataType\")\n (#eq? @base64 \"bin.base64\")\n (#eq? @input_property \"text\")\n (#eq? @output_property \"nodeTypedValue\")\n)\n"
      }
    },
    "reason": "Adjacent XML document creation, node creation, Base64 typing, value assignment and return bind the same receivers and conversion direction."
  },
