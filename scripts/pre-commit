#!/bin/sh
# traits pre-commit hook: block the commit unless the rules validate.
# Install with `make install-precommit`.
#
# `make validate` runs first and is the only gate: trait definitions are this
# repo's responsibility, and cleave/scan deliberately no longer validate them
# in their own test suites. A malformed trait file silently drops every rule in
# it at analysis time, so catching it here is the last cheap chance.
#
# Bypass in an emergency with `git commit --no-verify`.

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

echo "pre-commit: running make validate..."
make validate

echo "pre-commit: validation passed."
